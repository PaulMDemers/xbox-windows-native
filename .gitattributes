* text=auto
*.sh text eol=lf
*.py text eol=lf
*.patch -text
/outputs/video-nt5-display-package/*.inf -text whitespace=cr-at-eol
/outputs/shutdown-null-placeholder/xwntest.inf -text whitespace=cr-at-eol
/outputs/shutdown-device-install/xwnvideo.inf -text whitespace=cr-at-eol
# Unified-diff blank context lines contain their required leading space.
/outputs/fatx-cleanup-order/0099-vfat-cleanup-main-before-dir.patch whitespace=-blank-at-eol
/outputs/fatx-namespace-order/0100-vfat-namespace-file-order.patch whitespace=-blank-at-eol
outputs/fatx-directory-order/0101-vfat-directory-stream-lock-order.patch whitespace=-blank-at-eol

# Preserve exact source and evidence bytes used by append-diagnostic SHA256 records.
/outputs/fatx-append-boundary/** -text whitespace=cr-at-eol
/outputs/fatx-append-sequence/** -text whitespace=cr-at-eol
/outputs/fatx-first-install-0101/** -text whitespace=cr-at-eol

/outputs/fatx-install-alignment/** -text whitespace=cr-at-eol

/outputs/fatx-draw-append/** -text whitespace=cr-at-eol

/outputs/fatx-install-draw/** -text whitespace=cr-at-eol

/outputs/fatx-install-buffer/** -text whitespace=cr-at-eol

/outputs/fatx-setup-buffer/** -text whitespace=cr-at-eol

/outputs/fatx-target-buffer/** -text whitespace=cr-at-eol

/outputs/fatx-cache-buffer/** -text whitespace=cr-at-eol

/outputs/fatx-paging-buffer/** -text whitespace=cr-at-eol

outputs/fatx-interrupted-append/** -text whitespace=cr-at-eol

outputs/fatx-mapped-lifecycle/** -text whitespace=cr-at-eol

outputs/fatx-map-append-regression/** -text whitespace=cr-at-eol
outputs/fatx-map-truncate/** -text whitespace=cr-at-eol

outputs/fatx-prefix-forensics/** -text whitespace=cr-at-eol
outputs/fatx-map-rendezvous/** -text whitespace=cr-at-eol
outputs/baseline-event-forensics/** -text whitespace=cr-at-eol
outputs/baseline-hid-restore/** -text whitespace=cr-at-eol

outputs/dump-config-trace/** -text whitespace=cr-at-eol
outputs/dump-usage-trace/** -text whitespace=cr-at-eol
outputs/hal-dump-path/** -text whitespace=cr-at-eol
outputs/dump-fsctl-trace/** -text whitespace=cr-at-eol
outputs/fatx-dump-map/** -text whitespace=cr-at-eol
outputs/fatx-dump-map/*.patch whitespace=-blank-at-eol
outputs/fatx-dump-map/*/source/*.patch whitespace=-blank-at-eol
# The frozen inserted fragment retains its separator newline and exact hash.
outputs/fatx-dump-map/dump-map.inc whitespace=cr-at-eol,-blank-at-eof
outputs/fatx-dump-map/*/source/dump-map.inc whitespace=cr-at-eol,-blank-at-eof
# Unified-diff blank context lines are meaningful patch bytes.
outputs/hal-dump-path/*.patch whitespace=-blank-at-eol
outputs/hal-dump-path/*/source/*.patch whitespace=-blank-at-eol
outputs/dump-map-trace/** -text whitespace=cr-at-eol
outputs/controlled-dump/** -text whitespace=cr-at-eol
outputs/controlled-dump-observe/** -text whitespace=cr-at-eol
