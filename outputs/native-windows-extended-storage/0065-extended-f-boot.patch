diff --git a/boot/freeldr/freeldr/bootmgr.c b/boot/freeldr/freeldr/bootmgr.c
index 68e7d3e1..555cf90a 100644
--- a/boot/freeldr/freeldr/bootmgr.c
+++ b/boot/freeldr/freeldr/bootmgr.c
@@ -420,7 +420,11 @@ VOID RunLoader(VOID)
 #ifdef XBOX_NATIVE_NT5_HANDOFF
     {
         PCHAR Args[] = {"rosload", "BootType=Windows2000",
+#ifdef XBOX_NATIVE_EXTENDED_NT5_BOOT
+                       "SystemPartition=multi(0)disk(0)rdisk(0)partition(6)",
+#else
                        "SystemPartition=multi(0)disk(0)rdisk(0)partition(1)",
+#endif
 #ifdef XBOX_NATIVE_FATX_NT5_PREFLIGHT
                        "SystemPath=\\Applications\\XWNLoader\\WINNT",
 #else
diff --git a/boot/freeldr/freeldr/rosload.cmake b/boot/freeldr/freeldr/rosload.cmake
index 36ac672f..ca49b4a1 100644
--- a/boot/freeldr/freeldr/rosload.cmake
+++ b/boot/freeldr/freeldr/rosload.cmake
@@ -230,3 +230,12 @@ if(XBOX_NATIVE_EXTENDED_READ_PREFLIGHT)
     endif()
     target_compile_definitions(rosload PRIVATE XBOX_NATIVE_EXTENDED_READ_PREFLIGHT=1)
 endif()
+
+option(XBOX_NATIVE_EXTENDED_NT5_BOOT "Boot native Windows from Xbox partition 6" OFF)
+if(XBOX_NATIVE_EXTENDED_NT5_BOOT)
+    if(NOT SARCH STREQUAL "xbox" OR NOT XBOX_NATIVE_NT5_HANDOFF OR
+       XBOX_NATIVE_EXTENDED_READ_PREFLIGHT)
+        message(FATAL_ERROR "Extended NT5 boot requires Xbox handoff without read-only stop")
+    endif()
+    target_compile_definitions(rosload PRIVATE XBOX_NATIVE_EXTENDED_NT5_BOOT=1)
+endif()
