+/* MainResource is held by the caller. Match paging I/O's shared resource
+ * before shrinking sizes or releasing the backing cluster chain. */
+NTSTATUS
+VfatSetAllocationSizeInformation(
+    PFILE_OBJECT FileObject,
+    PVFATFCB Fcb,
+    PDEVICE_EXTENSION DeviceExt,
+    PLARGE_INTEGER AllocationSize)
+{
+    NTSTATUS Status;
+    BOOLEAN LockPaging = !BooleanFlagOn(Fcb->Flags, FCB_IS_PAGE_FILE) &&
+                         AllocationSize->QuadPart < Fcb->RFCB.FileSize.QuadPart;
+
+    if (LockPaging)
+        ExAcquireResourceExclusiveLite(&Fcb->PagingIoResource, TRUE);
+    _SEH2_TRY
+    {
+        Status = VfatSetAllocationSizeLocked(FileObject, Fcb, DeviceExt, AllocationSize);
+    }
+    _SEH2_FINALLY
+    {
+        if (LockPaging)
+            ExReleaseResourceLite(&Fcb->PagingIoResource);
+    }
+    _SEH2_END;
+    return Status;
+}
