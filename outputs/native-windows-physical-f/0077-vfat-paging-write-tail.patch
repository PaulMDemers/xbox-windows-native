         FsRtlAreThereCurrentFileLocks(&Fcb->FileLock))
     {
@@ -1325,7 +1376,20 @@ VfatWrite(
             vfatAddToStat(IrpContext->DeviceExt, Base.MetaDataWriteBytes, Length);
