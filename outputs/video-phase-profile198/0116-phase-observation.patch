@@ -122,3 +122,52 @@ VOID XwnRowSnapshot(PPDEV p, ULONG *out)
     out[9]=(ULONG)p->RowFastBytes;out[10]=(ULONG)(p->RowFastBytes>>32);
     EngReleaseSemaphore(XwnOwnerLock);
 }
+
+/* Separate elapsed diagnostic. Never hold membership lock across an Eng render
+ * call, clock query or framebuffer copy. It only protects64bit accounting and
+ * snapshots; it remains no replacement for GDI's submitted-PDEV lifetime. */
+VOID XwnProfileInit(PPDEV p)
+{
+    ULONG i; LONGLONG a,b;
+    p->Profile.Enabled=XWN_BODY_PROFILE;
+    p->Profile.Minimum=~(ULONGLONG)0;
+    EngQueryPerformanceFrequency(&p->Profile.Frequency);
+    if (p->Profile.Frequency<=0) ++p->Profile.Errors;
+    for(i=0;i<128;i++) {
+        a=b=-1;EngQueryPerformanceCounter(&a);EngQueryPerformanceCounter(&b);
+        XwnProfileCalibration(&p->Profile,a,b);
+    }
+}
+LONGLONG XwnProfileStart(VOID)
+{
+#if XWN_BODY_PROFILE
+    LONGLONG tick=-1;EngQueryPerformanceCounter(&tick);return tick;
+#else
+    return 0;
+#endif
+}
+VOID XwnProfileEnd(PPDEV p, ULONG kind, LONGLONG begin)
+{
+    LONGLONG end=XwnProfileStart();
+    EngAcquireSemaphore(XwnOwnerLock);
+    XwnProfileAccumulate(&p->Profile,kind,begin,end);
+    EngReleaseSemaphore(XwnOwnerLock);
+}
+VOID XwnProfileSnapshot(PPDEV p, ULONG *out)
+{
+    ULONG i,at;
+    RtlZeroMemory(out,128);
+    EngAcquireSemaphore(XwnOwnerLock);
+    out[0]=0x544d5758;out[1]=113;out[2]=128;out[3]=p->Profile.Enabled;
+    out[4]=(ULONG)p->Profile.Frequency;out[5]=(ULONG)((ULONGLONG)p->Profile.Frequency>>32);
+    out[6]=p->Profile.Samples;
+    out[7]=(ULONG)p->Profile.Minimum;out[8]=(ULONG)(p->Profile.Minimum>>32);
+    out[9]=(ULONG)p->Profile.Maximum;out[10]=(ULONG)(p->Profile.Maximum>>32);
+    out[11]=p->Profile.Errors;out[12]=p->Profile.Overflows;
+    for(i=0;i<4;i++) {
+        at=14+i*3;out[at]=p->Profile.Count[i];
+        out[at+1]=(ULONG)p->Profile.Ticks[i];out[at+2]=(ULONG)(p->Profile.Ticks[i]>>32);
+    }
+    out[26]=p->Profile.Reads;
+    EngReleaseSemaphore(XwnOwnerLock);
+}
diff --git a/win32ss/drivers/displays/framebuf/profile_math.h b/win32ss/drivers/displays/framebuf/profile_math.h
new file mode 100644
index 0000000..0b04147
--- /dev/null
+++ b/win32ss/drivers/displays/framebuf/profile_math.h
@@ -0,0 +1,40 @@
+/* Diagnostic arithmetic, GPL-2.0-or-later as framebuf. ULONG/ULONGLONG/LONGLONG
+ * are supplied by the NT5 DDK (or exact-width host test shim). */
+typedef struct {
+    LONGLONG Frequency;
+    ULONGLONG Minimum, Maximum, Ticks[4];
+    ULONG Count[4], Errors, Overflows, Reads, Samples, Enabled;
+} XWN_PROFILE;
+static void XwnProfileIncrement(ULONG *value, ULONG *overflows)
+{
+    if (*value != (ULONG)~(ULONG)0) ++*value;
+    else if (*overflows != (ULONG)~(ULONG)0) ++*overflows;
+}
+static void XwnProfileCalibration(XWN_PROFILE *s, LONGLONG before, LONGLONG after)
+{
+    ULONGLONG delta;
+    XwnProfileIncrement(&s->Reads,&s->Overflows);
+    XwnProfileIncrement(&s->Reads,&s->Overflows);
+    XwnProfileIncrement(&s->Samples,&s->Overflows);
+    if (before < 0 || after < before) {
+        XwnProfileIncrement(&s->Errors,&s->Overflows); return;
+    }
+    delta=(ULONGLONG)after-(ULONGLONG)before;
+    if (delta<s->Minimum) s->Minimum=delta;
+    if (delta>s->Maximum) s->Maximum=delta;
+}
+static void XwnProfileAccumulate(XWN_PROFILE *s, ULONG kind, LONGLONG before, LONGLONG after)
+{
+    ULONGLONG delta;
+    if (kind>=4) {XwnProfileIncrement(&s->Errors,&s->Overflows);return;}
+    XwnProfileIncrement(&s->Count[kind],&s->Overflows);
+    if (!s->Enabled) return;
+    XwnProfileIncrement(&s->Reads,&s->Overflows);
+    XwnProfileIncrement(&s->Reads,&s->Overflows);
+    if (before<0 || after<before) {XwnProfileIncrement(&s->Errors,&s->Overflows);return;}
+    delta=(ULONGLONG)after-(ULONGLONG)before;
+    if (delta>(~(ULONGLONG)0)-s->Ticks[kind]) {
+        s->Ticks[kind]=~(ULONGLONG)0;
+        XwnProfileIncrement(&s->Overflows,&s->Overflows);
+    } else s->Ticks[kind]+=delta;
+}
