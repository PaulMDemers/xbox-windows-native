+int xwn_hd_get_profile(unsigned mode,struct xwn_hd_profile *out) {
+ if(!out || mode<XWN_HD_720P || mode>XWN_HD_1080I)return 0;
+ *out=profiles[mode-1];return 1;
+}
+int xwn_hd_layout_valid(unsigned mode,uint32_t ram_bytes,uint32_t fb_start,
+                        uint32_t reserved_bytes,uint32_t hidden_bytes) {
+ struct xwn_hd_profile p;
+ if(!xwn_hd_get_profile(mode,&p))return 0;
+ if(ram_bytes!=64u*1024u*1024u || fb_start!=55u*1024u*1024u ||
+    reserved_bytes!=9u*1024u*1024u || hidden_bytes!=316160u)return 0;
+ if(fb_start>ram_bytes || reserved_bytes>ram_bytes-fb_start ||
+    hidden_bytes>reserved_bytes || p.visible_bytes>reserved_bytes-hidden_bytes)return 0;
+ return 1;
+}
