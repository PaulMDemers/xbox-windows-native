+static const struct xwn_hd_profile profiles[2]={
+ {1280u,720u,5120u,3686400u,0u,{0xc8,0x9f,0x9f,0x8c,0xa7,0x31,0xec,0xf0,0x0,0x60,0x0,0x0,0x0,0x0,0x0,0x0,0xd4,0x9,0xcf,0x80,0x0,0xcf,0xed,0xe3,0xff,0x40,0x38,0x5,0x80,0x10,0x0,0x11,0xff,0x0,0x83},{0x10000000,0x10000000,0x0,0x40801080,0x801080,0x3,0x2cf,0x2ed,0x2cf,0x2d4,0x2d9,0x0,0x2cf,0x4ff,0x671,0x4ff,0x545,0x595,0x0,0x4ff,0x10100111,0x672,0x1,0x14a,0x528,0x1,0x21101100,0x100030},{0xc,0xaa,0x49,0x90,0x8c,0x8c,0x1,0x9c,0xe1,0x21,0x0,0x0,0x46,0x28}},
