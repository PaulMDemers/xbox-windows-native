--- /dev/null
+++ b/drivers/video/xwn_hd_profile.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Explicit Conexant HDTV timing profiles for the reviewed 64MiB/9MiB handoff.
+ * Pure data preparation: NO hardware access or encoder readback assumptions.
+ */
+#ifndef XWN_HD_PROFILE310_H
+#define XWN_HD_PROFILE310_H
+#include <stdint.h>
+enum xwn_hd_mode { XWN_HD_720P=1, XWN_HD_1080I=2 };
+struct xwn_hd_profile {
+ uint32_t width,height,stride,visible_bytes,interlaced;
+ uint8_t crtc[35];
+ uint32_t mmio[28];
+ uint8_t encoder[14];
+};
+extern const uint8_t xwn_hd_crtc_indices[35];
+extern const uint32_t xwn_hd_mmio_offsets[28];
+extern const uint8_t xwn_hd_encoder_indices[14];
+/* Invalid mode/output leaves caller storage unchanged. */
+int xwn_hd_get_profile(unsigned mode,struct xwn_hd_profile *out);
+/* Exact reviewed ABI2 memory layout only. Geometry comes from selected profile,
+ * not analog HVALID or an arbitrary caller-supplied stride. */
+int xwn_hd_layout_valid(unsigned mode,uint32_t ram_bytes,uint32_t fb_start,
+                        uint32_t reserved_bytes,uint32_t hidden_bytes);
+#endif
diff --git a/include/memory_layout.h b/include/memory_layout.h
index da330cb46028f45583d4f7410573b9e88c67b6a1..a33ec16b508dd0ac3473db3f7aba168323273ee0 100644
--- a/include/memory_layout.h
+++ b/include/memory_layout.h
@@ -19,11 +19,16 @@
 #define KERNEL_LOAD_TMP    0x01000000
 
 /*
- * Modern bzImages prefer to decompress at 16 MB and can occupy roughly
- * 13 MB there. Keep the initrd above that kernel image window.
+ * The legacy allocator always manages 16 MB, ignoring its length argument.
+ * Its heap starts at 22 MB and ends at 38 MB. Keep the initrd at 40 MB so
+ * live USB allocations cannot overwrite it while FATX files are loading.
  */
-#define INITRD_START       0x02000000
+#define INITRD_START       0x02800000
+#ifdef XWN_HD_RESERVATION
+#define MAX_INITRD_END     0x03700000
+#else
 #define MAX_INITRD_END     0x03800000
+#endif
 
 #define MAX_KERNEL_SIZE    (KERNEL_PM_CODE_END - KERNEL_PM_CODE)
 #define MAX_INITRD_SIZE    (MAX_INITRD_END - INITRD_START)
@@ -33,18 +38,20 @@
 #define FREELDR_MAX_SIZE   0x80000
 
 /*
- * Keep Cromwell's heap below the initrd. The old layout put the heap above
- * MAX_INITRD_END; widening the initrd window for Tiny Core left too little
- * heap for early video/FATX setup and xemu stayed black.
+ * Reserve the full 16 MB actually used by t_malloc (1024 x 16 KB blocks).
  */
 #define MEMORYMANAGERSTART 0x01600000
-#define MEMORYMANAGEREND   0x01FFFFFF
+#define MEMORYMANAGEREND   0x02600000
 #define MEMORYMANAGERSIZE  (MEMORYMANAGEREND - MEMORYMANAGERSTART)
 
-#define STACK_TOP 0x03C00000
+#define STACK_TOP 0x02800000
 
 /* the size of the framebuffer (defaults to 4 MB) */
+#ifdef XWN_HD_RESERVATION
+#define FB_SIZE 0x00900000
+#else
 #define FB_SIZE 0x00400000
+#endif
 /* the start of the framebuffer */
 #define FB_START (0xf0000000 | (RAMSIZE - FB_SIZE))
 
