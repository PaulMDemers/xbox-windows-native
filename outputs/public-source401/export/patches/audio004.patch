@@ -0,0 +1,30 @@
+# Experimental: name/structure audit target, not yet boot compatible.
+if(NOT ARCH STREQUAL "i386" OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
+    message(FATAL_ERROR "XBOX_NT5_HAL requires an i386 Release (free UP) build")
+endif()
+remove_definitions(-D_WIN32_WINNT=0x502 -DWINVER=0x502)
+add_definitions(-D_WIN32_WINNT=0x500 -DWINVER=0x500 -DNTDDI_VERSION=0x05000000
+                -DXBOX_NT5_HAL -DSARCH_XBOX)
+include_directories(${CMAKE_CURRENT_BINARY_DIR}/..)
+set(NT5_SOURCE)
+foreach(source ${HAL_XBOX_SOURCE} ${HAL_XBOX_ASM_SOURCE} ${HAL_UP_SOURCE})
+    if(IS_ABSOLUTE "${source}")
+        set_source_files_properties("${source}" PROPERTIES GENERATED TRUE)
+        list(APPEND NT5_SOURCE "${source}")
+    else()
+        list(APPEND NT5_SOURCE "../${source}")
+    endif()
+endforeach()
+spec2def(halxboxnt5.dll halnt5.spec)
+add_asm_files(nt5_boundary_asm boundary.S)
+add_library(halxboxnt5 MODULE ${NT5_SOURCE} ${nt5_boundary_asm} fmutex.c trapentry.c kdport.c translate.c rootbus.c ../xbox/halxbox.rc
+            ${CMAKE_CURRENT_BINARY_DIR}/halxboxnt5.def)
+target_link_libraries(halxboxnt5 cportlib libcntpr setjmp fast486 ${PSEH_LIB})
+add_importlibs(halxboxnt5 ntoskrnl)
+add_dependencies(halxboxnt5 psdk asm bugcodes xdk xbox_nt5_pcidata)
+set_module_type(halxboxnt5 kerneldll ENTRYPOINT HalInitSystem 8)
+if(NOT MSVC)
+    target_link_libraries(halxboxnt5 -lgcc)
+    target_link_options(halxboxnt5 PRIVATE -Wl,--subsystem,native:5.0
+        -Wl,--minor-image-version,0 -Wl,--minor-os-version,0)
+endif()
diff --git a/hal/halx86/xboxnt5/boundary.S b/hal/halx86/xboxnt5/boundary.S
new file mode 100644
index 0000000000000000000000000000000000000000..d82a1442a4def4c8c7b5f76cf33eed15ec6e4d9e
--- /dev/null
+++ b/hal/halx86/xboxnt5/boundary.S
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Windows 2000 i386 boundary. Contracts verified against supplied 2195.7376.
+ * These entry points adapt the HAL's C interfaces to the native NT5 ABI.
+ */
+#include <asm.inc>
+.code
+EXTERN __imp__Kei386EoiHelper@0:DWORD
+EXTERN __imp_@KeUpdateSystemTime@12:DWORD
+EXTERN __imp__KiDispatchInterrupt@0:DWORD
+EXTERN _HalEndSystemInterrupt@8:PROC
+
+PUBLIC @HalpNt5Eoi@4
+.PROC @HalpNt5Eoi@4
+    /* Discard every C frame. The kernel restores registers and executes IRET. */
+    mov ebp, ecx
+    mov esp, ecx
+    jmp dword ptr [__imp__Kei386EoiHelper@0]
+.ENDP
+
+PUBLIC @HalpNt5UpdateSystemTime@12
+.PROC @HalpNt5UpdateSystemTime@12
+    /* ECX=trap, EDX=increment, [ESP+4]=old IRQL. Native NT expects no return
+     * address: [ESP]=old IRQL, [ESP+4]=vector, [ESP+8]=trap frame. */
+    movzx eax, byte ptr [esp+4]
+    mov ebp, ecx
+    mov esp, ecx
+    push HEX(30) /* Xbox PIC primary vector + IRQ0 */
+    push eax
+    mov eax, edx
+    jmp dword ptr [__imp_@KeUpdateSystemTime@12]
+.ENDP
+
+PUBLIC _HalpNt5EndSystemInterrupt@8
+.PROC _HalpNt5EndSystemInterrupt@8
+    /* Native NT passes a vector as argument 2; our PIC code needs EBP's trap.
+     * Keep the internal HalEndSystemInterrupt ABI for all HAL C callers. */
+    push ebp
+    push dword ptr [esp+8]
+    call _HalEndSystemInterrupt@8
+    ret 8
+.ENDP
+
+PUBLIC _HalpNt5DispatchInterrupt@0
+.PROC _HalpNt5DispatchInterrupt@0
+    /* NT's assembly DPC helper clobbers EBX. Isolate the C caller from all
+     * native nonvolatile-register assumptions. */
+    push ebp
+    push ebx
+    push esi
+    push edi
+    call dword ptr [__imp__KiDispatchInterrupt@0]
+    pop edi
+    pop esi
+    pop ebx
+    pop ebp
+    ret
+.ENDP
+END
