diff --git a/sdk/include/reactos/drivers/xbox/xwn_hd_layout.h b/sdk/include/reactos/drivers/xbox/xwn_hd_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..a27594e0d9163ef13796ea091d5fce22aa912988
--- /dev/null
+++ b/sdk/include/reactos/drivers/xbox/xwn_hd_layout.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef XWN_HD_LAYOUT_H
+#define XWN_HD_LAYOUT_H
+
+/* Opt-in retail64 reservation. No timing, cache policy or GPU ownership change. */
+#define XWN_HD_RAM_BYTES 0x04000000u
+#define XWN_HD_FB_BYTES 0x00900000u
+#define XWN_HD_FB_PHYSICAL 0x03700000u
+#define XWN_HD_BOOT_BACK_BYTES (640u * (480u + 13u + 1u))
+#define XWN_HD_HIDDEN_OFFSET (XWN_HD_FB_BYTES - XWN_HD_BOOT_BACK_BYTES)
+
+static inline int
+XwnHdLayoutValid(unsigned int Physical, unsigned int Reserved,
+                 unsigned int Width, unsigned int Height,
+                 unsigned int Stride, unsigned int Hidden)
+{
+    if (Physical != XWN_HD_FB_PHYSICAL || Reserved != XWN_HD_FB_BYTES ||
+        Width < 640u || Width > 1920u || Height < 480u || Height > 1080u ||
+        Stride != Width * 4u || Hidden != XWN_HD_HIDDEN_OFFSET)
+        return 0;
+    /* Bounded dimensions above prevent overflow; division retains the tail. */
+    return Height <= Hidden / Stride;
+}
+
+static inline int
+XwnHdMapEntryValid(unsigned int Slot, unsigned int Base, unsigned int BaseHigh,
+                  unsigned int Length, unsigned int LengthHigh, unsigned int Type)
+{
+    if (BaseHigh || LengthHigh) return 0;
+    if (Slot == 0u)
+        return Base == 0u && Length == XWN_HD_FB_PHYSICAL && Type == 1u;
+    if (Slot == 1u)
+        return Base == XWN_HD_FB_PHYSICAL && Length == XWN_HD_FB_BYTES && Type == 0u;
+    return 0;
+}
+#endif
diff --git a/sdk/include/reactos/xboxpart.h b/sdk/include/reactos/xboxpart.h
new file mode 100644
index 0000000000000000000000000000000000000000..531adf397aef613375d247a3723f39005a010bbf
--- /dev/null
+++ b/sdk/include/reactos/xboxpart.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Bounded parser for the Xbox LBA48 PARTINFO format. No disk I/O or writes.
+ * Format reference: NKPatcher lba48.inc and xa_lba48.asm (see REFERENCES.txt).
+ */
+#ifndef XWN_XBOXPART_H
+#define XWN_XBOXPART_H
+
+typedef struct XWN_XBOX_PARTITION
+{
+    unsigned int Start;
+    unsigned int Count;
+} XWN_XBOX_PARTITION;
+
+#define XWN_XBOX_MAX_PARTITIONS 14
+#define XWN_XBOX_TABLE_ABSENT 0
+#define XWN_XBOX_TABLE_VALID 1
+#define XWN_XBOX_TABLE_INVALID (-1)
+
+static unsigned int XwnXboxReadU32(const unsigned char *p)
+{
+    return (unsigned int)p[0] | ((unsigned int)p[1] << 8) |
+           ((unsigned int)p[2] << 16) | ((unsigned int)p[3] << 24);
+}
+
+/* Output is usable only on TABLE_VALID. Reject unknown extensions, holes,
+ * overflow, overlap and out-of-disk extents; never fall back after bad magic-
+ * bearing metadata. Sector count must come from the device, not this table.
+ */
+static int XwnXboxParsePartitionTable(const unsigned char *sector,
+    unsigned int bytes, unsigned long long diskSectors,
+    XWN_XBOX_PARTITION *parts, unsigned int *partCount)
+{
+    static const char magic[] = "****PARTINFO****";
+    unsigned int i, j, active = 0;
+    int gap = 0;
+    *partCount = 0;
+    if (bytes < 16) return XWN_XBOX_TABLE_INVALID;
+    for (i = 0; i < 16; ++i)
+        if (sector[i] != (unsigned char)magic[i]) return XWN_XBOX_TABLE_ABSENT;
+    if (bytes != 512 || !diskSectors) return XWN_XBOX_TABLE_INVALID;
+    for (i = 16; i < 48; ++i)
+        if (sector[i]) return XWN_XBOX_TABLE_INVALID;
+    for (i = 496; i < 512; ++i)
+        if (sector[i]) return XWN_XBOX_TABLE_INVALID;
+    for (i = 0; i < XWN_XBOX_MAX_PARTITIONS; ++i)
+    {
+        const unsigned char *entry = sector + 48 + i * 32;
+        unsigned int flags = XwnXboxReadU32(entry + 16);
+        unsigned int start = XwnXboxReadU32(entry + 20);
+        unsigned int count = XwnXboxReadU32(entry + 24);
+        parts[i].Start = parts[i].Count = 0;
+        if (XwnXboxReadU32(entry + 28) || (flags & ~0x80000000U))
+            return XWN_XBOX_TABLE_INVALID;
+        if (!(flags & 0x80000000U))
+        {
+            gap = 1;
+            continue;
+        }
+        if (gap || start < 1024 || !count ||
+            (unsigned long long)start >= diskSectors ||
+            (unsigned long long)count > diskSectors - start)
+            return XWN_XBOX_TABLE_INVALID;
+        for (j = 0; j < i; ++j)
+            if ((unsigned long long)start < (unsigned long long)parts[j].Start + parts[j].Count &&
+                (unsigned long long)parts[j].Start < (unsigned long long)start + count)
+                return XWN_XBOX_TABLE_INVALID;
+        parts[i].Start = start;
+        parts[i].Count = count;
+        active = i + 1;
+    }
+    /* Existing Xbox volumes must remain represented; optional F/G follow. */
+    if (active < 5) return XWN_XBOX_TABLE_INVALID;
+    *partCount = active;
+    return XWN_XBOX_TABLE_VALID;
+}
+#endif
