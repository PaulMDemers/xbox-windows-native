+        XwnPagingText(11, "Windows kernel NOT entered. Photograph, then reboot.", 0xFFFFFFFF);
+        _disable(); for (;;) __halt();
+    }
+    XwnEntryRecord[4] = (ULONG_PTR)LoaderBlock;
+    XwnEntryRecord[5] = XwnHandoffRecord[6];
