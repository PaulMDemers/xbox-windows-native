diff --git a/hal/halx86/xboxnt5/rootbus.c b/hal/halx86/xboxnt5/rootbus.c
new file mode 100644
index 0000000000000000000000000000000000000000..b7b2d88638e31b8adf31c02b977219894cd57571
--- /dev/null
+++ b/hal/halx86/xboxnt5/rootbus.c
@@ -0,0 +1,149 @@
+/*
+ * PROJECT: Xbox NT5 HAL experiment
+ * LICENSE: GPL-2.0-or-later (see ReactOS COPYING)
+ * PURPOSE: Root PCI apertures for Windows 2000 resource arbitration.
+ * The original empty root resource list leaves every PCI address reserved.
+ * Report PNPBus resources in the native NT5 format: shared, fixed windows.
+ */
+#include <hal.h>
+
+#define NT5_MAX_PORT_RANGES 64
+#define NT5_ROOT_DESCRIPTORS (NT5_MAX_PORT_RANGES + 3)
+
+NTSTATUS NTAPI
+HalpNt5QueryRootResources(PCM_RESOURCE_LIST *Resources)
+{
+    struct { ULONG Start, End; } Reserved[NT5_MAX_PORT_RANGES], Swap;
+    ULONG Used = 0, i, j, Start, End, Cursor, Count = 0, Bytes;
+    PADDRESS_USAGE Usage;
+    PCM_RESOURCE_LIST List;
+    PCM_PARTIAL_RESOURCE_DESCRIPTOR Desc;
+    if (!Resources) return STATUS_INVALID_PARAMETER;
+    *Resources = NULL;
+    /* Complement the HAL's actual reservations instead of advertising PIC,
+       timer, CMOS, DMA, debugger or PCI configuration ports to child devices. */
+    for (Usage = HalpAddressUsageList; Usage; Usage = Usage->Next)
+    {
+        if (Usage->Type != CmResourceTypePort) continue;
+        for (i = 0; Usage->Element[i].Length; ++i)
+        {
+            Start = Usage->Element[i].Start;
+            if (Start >= 0x10000) continue;
+            if (Used == NT5_MAX_PORT_RANGES) return STATUS_INSUFFICIENT_RESOURCES;
+            End = Start + min(Usage->Element[i].Length, 0x10000 - Start);
+            Reserved[Used].Start = Start;
+            Reserved[Used++].End = End;
+        }
+    }
+    for (i = 1; i < Used; ++i)
+    {
+        Swap = Reserved[i]; j = i;
+        while (j && Reserved[j - 1].Start > Swap.Start)
+        {
+            Reserved[j] = Reserved[j - 1]; --j;
+        }
+        Reserved[j] = Swap;
+    }
+    Bytes = FIELD_OFFSET(CM_RESOURCE_LIST, List[0].PartialResourceList.PartialDescriptors) +
+            NT5_ROOT_DESCRIPTORS * sizeof(*Desc);
+    List = ExAllocatePoolWithTag(PagedPool, Bytes, TAG_HAL);
+    if (!List) return STATUS_INSUFFICIENT_RESOURCES;
+    RtlZeroMemory(List, Bytes);
+    List->Count = 1;
+    List->List[0].InterfaceType = PNPBus;
+    List->List[0].BusNumber = (ULONG)-1;
+    List->List[0].PartialResourceList.Version = 1;
+    List->List[0].PartialResourceList.Revision = 1;
+    Desc = List->List[0].PartialResourceList.PartialDescriptors;
+    Desc[Count].Type = CmResourceTypeBusNumber;
+    Desc[Count].ShareDisposition = CmResourceShareShared;
+    Desc[Count++].u.BusNumber.Length = 256;
+    Cursor = 0;
+    for (i = 0; i <= Used; ++i)
+    {
+        Start = (i == Used) ? 0x10000 : Reserved[i].Start;
+        if (Start > Cursor)
+        {
+            Desc[Count].Type = CmResourceTypePort;
+            Desc[Count].ShareDisposition = CmResourceShareShared;
+            Desc[Count].Flags = CM_RESOURCE_PORT_IO;
+            Desc[Count].u.Port.Start.QuadPart = Cursor;
+            Desc[Count++].u.Port.Length = Start - Cursor;
+        }
+        if (i != Used) Cursor = max(Cursor, Reserved[i].End);
+    }
+    /* Xbox PCI device/bridge apertures observed in firmware configuration:
+       NV2A framebuffer at F0000000, GPU at FD000000, MCP devices at FE8xxxxx
+       through FEFxxxxx. Exclude RAM and the FFxxxxxx flash/firmware window. */
+    Desc[Count].Type = CmResourceTypeMemory;
+    Desc[Count].ShareDisposition = CmResourceShareShared;
+    Desc[Count].u.Memory.Start.QuadPart = 0xf0000000ULL;
+    Desc[Count++].u.Memory.Length = 0x0f000000;
+    ASSERT(Count <= NT5_ROOT_DESCRIPTORS);
+    List->List[0].PartialResourceList.Count = Count;
+    *Resources = List;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS NTAPI
+HalpNt5QueryRootRequirements(PIO_RESOURCE_REQUIREMENTS_LIST *Requirements)
+{
+    PCM_RESOURCE_LIST Resources;
+    PCM_PARTIAL_RESOURCE_DESCRIPTOR Source;
+    PIO_RESOURCE_REQUIREMENTS_LIST Result;
+    PIO_RESOURCE_DESCRIPTOR Target;
+    ULONG Count, Bytes, i;
+    NTSTATUS Status;
+    if (!Requirements) return STATUS_INVALID_PARAMETER;
+    *Requirements = NULL;
+    Status = HalpNt5QueryRootResources(&Resources);
+    if (!NT_SUCCESS(Status)) return Status;
+    Count = Resources->List[0].PartialResourceList.Count;
+    Bytes = FIELD_OFFSET(IO_RESOURCE_REQUIREMENTS_LIST, List[0].Descriptors) +
+            (Count + 1) * sizeof(*Target);
+    Result = ExAllocatePoolWithTag(PagedPool, Bytes, TAG_HAL);
+    if (!Result)
+    {
+        ExFreePool(Resources);
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    RtlZeroMemory(Result, Bytes);
+    Result->ListSize = Bytes;
+    Result->InterfaceType = PNPBus;
+    Result->BusNumber = (ULONG)-1;
+    Result->AlternativeLists = 1;
+    Result->List[0].Version = Result->List[0].Revision = 1;
+    Result->List[0].Count = Count + 1;
+    Target = Result->List[0].Descriptors;
+    Target->Type = CmResourceTypeConfigData;
+    Target->ShareDisposition = CmResourceShareShared;
+    Target->Option = IO_RESOURCE_PREFERRED;
+    Target->u.ConfigData.Priority = 1;
+    ++Target;
+    Source = Resources->List[0].PartialResourceList.PartialDescriptors;
+    for (i = 0; i < Count; ++i, ++Target, ++Source)
+    {
+        Target->Option = IO_RESOURCE_PREFERRED;
+        Target->Type = Source->Type;
+        Target->ShareDisposition = Source->ShareDisposition;
+        Target->Flags = Source->Flags;
+        if (Source->Type == CmResourceTypeBusNumber)
+        {
+            Target->u.BusNumber.Length = 256;
+            Target->u.BusNumber.MinBusNumber = 0;
+            Target->u.BusNumber.MaxBusNumber = 255;
+        }
+        else
+        {
+            /* Port and Memory union layouts share the same fields. */
+            Target->u.Memory.Length = Source->u.Memory.Length;
+            Target->u.Memory.Alignment = 1;
+            Target->u.Memory.MinimumAddress = Source->u.Memory.Start;
+            Target->u.Memory.MaximumAddress.QuadPart = Source->u.Memory.Start.QuadPart +
+                                                     Source->u.Memory.Length - 1;
+        }
+    }
+    ExFreePool(Resources);
+    *Requirements = Result;
+    return STATUS_SUCCESS;
+}
diff --git a/hal/halx86/xboxnt5/translate.c b/hal/halx86/xboxnt5/translate.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd32e70271cd5acd89c89d495e394a85ac8f674a
--- /dev/null
+++ b/hal/halx86/xboxnt5/translate.c
@@ -0,0 +1,191 @@
+/*
+ * PROJECT: Xbox NT5 HAL experiment
+ * LICENSE: GPL-2.0-or-later (see ReactOS COPYING)
+ * PURPOSE: Fixed PIC interrupt translation for NT5 PnP.
+ * Based on the public ReactOS translator contract (fstub/translate.c).
+ * PCI routes are the firmware-programmed InterruptLine values; this does not
+ * implement an ACPI/APIC router or change chipset routing registers.
+ */
+#include <hal.h>
+
+C_ASSERT(sizeof(TRANSLATOR_INTERFACE) == 24);
+#undef HalGetInterruptTranslator
+C_ASSERT(FIELD_OFFSET(HAL_DISPATCH, HalGetInterruptTranslator) == 0x40);
+
+/* The firmware's PIC ELCR, recorded by HalpInitializePICs. PCI's generic
+ * level-sensitive descriptors are not the trigger mode of every Xbox line
+ * (notably USB0 is wired to the edge-only PIC IRQ 1). Match the translated
+ * contract to the actual PIC; preserve unrelated descriptor flag bits.
+ */
+extern LONG HalpEisaELCR;
+static USHORT HalpNt5PciInterruptFlags(USHORT Flags, ULONG Line)
+{
+    return (Flags & ~CM_RESOURCE_INTERRUPT_LATCHED) |
+           ((HalpEisaELCR & (1 << Line)) ? CM_RESOURCE_INTERRUPT_LEVEL_SENSITIVE :
+                                         CM_RESOURCE_INTERRUPT_LATCHED);
+}
+
+static VOID NTAPI HalpNt5TranslatorReference(PVOID Context) { }
+
+static NTSTATUS
+HalpNt5PciLine(PDEVICE_OBJECT Pdo, PULONG Line)
+{
+    ULONG Bus, Address, Length;
+    PCI_SLOT_NUMBER Slot;
+    UCHAR Interrupt[2];
+    NTSTATUS Status;
+    if (!Pdo) return STATUS_INVALID_PARAMETER;
+    Status = IoGetDeviceProperty(Pdo, DevicePropertyBusNumber,
+                                sizeof(Bus), &Bus, &Length);
+    if (!NT_SUCCESS(Status)) return Status;
+    if (Length != sizeof(Bus) || Bus > 255) return STATUS_INVALID_PARAMETER;
+    Status = IoGetDeviceProperty(Pdo, DevicePropertyAddress,
+                                sizeof(Address), &Address, &Length);
+    if (!NT_SUCCESS(Status)) return Status;
+    if (Length != sizeof(Address) || (Address >> 16) > 31 ||
+        (Address & 0xffff) > 7) return STATUS_INVALID_PARAMETER;
+    Slot.u.AsULONG = 0;
+    Slot.u.bits.DeviceNumber = Address >> 16;
+    Slot.u.bits.FunctionNumber = Address & 0xffff;
+    if (HalGetBusDataByOffset(PCIConfiguration, Bus, Slot.u.AsULONG,
+                             Interrupt, 0x3c, sizeof(Interrupt)) != sizeof(Interrupt))
+        return STATUS_UNSUCCESSFUL;
+    if (!Interrupt[1] || Interrupt[1] > 4 || !Interrupt[0] || Interrupt[0] >= 16)
+        return STATUS_UNSUCCESSFUL;
+    *Line = Interrupt[0];
+    return STATUS_SUCCESS;
+}
+
+static ULONG
+HalpNt5TranslateLine(ULONG Line, PKIRQL Irql, PKAFFINITY Affinity)
+{
+    if (Line >= 16) return 0;
+    return HalGetInterruptVector(Isa, 0, Line, Line, Irql, Affinity);
+}
+
+NTSTATUS NTAPI
+HalpNt5TranslateResource(PVOID Context, PCM_PARTIAL_RESOURCE_DESCRIPTOR Source,
+                        RESOURCE_TRANSLATION_DIRECTION Direction,
+                        ULONG AlternativesCount, PIO_RESOURCE_DESCRIPTOR Alternatives,
+                        PDEVICE_OBJECT Pdo, PCM_PARTIAL_RESOURCE_DESCRIPTOR Target)
+{
+    ULONG Line, Vector, i, Minimum, Maximum;
+    KIRQL Irql;
+    KAFFINITY Affinity;
+    NTSTATUS Status;
+    if (!Source || !Target || Source->Type != CmResourceTypeInterrupt)
+        return STATUS_INVALID_PARAMETER;
+    if (Direction == TranslateChildToParent)
+    {
+        Vector = HalpNt5TranslateLine(Source->u.Interrupt.Vector, &Irql, &Affinity);
+        if (!Vector) return STATUS_UNSUCCESSFUL;
+        *Target = *Source;
+        if ((ULONG_PTR)Context == PCIBus)
+            Target->Flags = HalpNt5PciInterruptFlags(Source->Flags,
+                                                    Source->u.Interrupt.Vector);
+        Target->u.Interrupt.Vector = Vector;
+        Target->u.Interrupt.Level = Irql;
+        Target->u.Interrupt.Affinity = Affinity;
+        return STATUS_TRANSLATION_COMPLETE;
+    }
+    if (Direction != TranslateParentToChild) return STATUS_INVALID_PARAMETER;
+    if ((ULONG_PTR)Context == PCIBus)
+    {
+        Status = HalpNt5PciLine(Pdo, &Line);
+        if (!NT_SUCCESS(Status)) return Status;
+        Vector = HalpNt5TranslateLine(Line, &Irql, &Affinity);
+        if (!Vector || Vector != Source->u.Interrupt.Vector) return STATUS_UNSUCCESSFUL;
+    }
+    else
+    {
+        if (!Alternatives || !AlternativesCount) return STATUS_INVALID_PARAMETER;
+        for (i = 0; i < AlternativesCount; ++i)
+        {
+            if (Alternatives[i].Type != CmResourceTypeInterrupt) continue;
+            Minimum = Alternatives[i].u.Interrupt.MinimumVector;
+            Maximum = min(Alternatives[i].u.Interrupt.MaximumVector, 15);
+            for (Line = Minimum; Line <= Maximum; ++Line)
+            {
+                Vector = HalpNt5TranslateLine(Line, &Irql, &Affinity);
+                if (Vector && Vector == Source->u.Interrupt.Vector) goto Found;
+            }
+        }
+        return STATUS_UNSUCCESSFUL;
+    }
+Found:
+    *Target = *Source;
+    if ((ULONG_PTR)Context == PCIBus)
+        Target->Flags = HalpNt5PciInterruptFlags(Source->Flags, Line);
+    Target->u.Interrupt.Vector = Target->u.Interrupt.Level = Line;
+    Target->u.Interrupt.Affinity = (KAFFINITY)-1;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS NTAPI
+HalpNt5TranslateRequirements(PVOID Context, PIO_RESOURCE_DESCRIPTOR Source,
+                            PDEVICE_OBJECT Pdo, PULONG TargetCount,
+                            PIO_RESOURCE_DESCRIPTOR *Target)
+{
+    ULONG Minimum, Maximum, Line, Vector, Count = 0, Vectors[16];
+    KIRQL Irql;
+    KAFFINITY Affinity;
+    NTSTATUS Status;
+    PIO_RESOURCE_DESCRIPTOR Result;
+    if (!Target || !TargetCount) return STATUS_INVALID_PARAMETER;
+    *Target = NULL;
+    *TargetCount = 0;
+    if (!Source || Source->Type != CmResourceTypeInterrupt)
+        return STATUS_INVALID_PARAMETER;
+    if ((ULONG_PTR)Context == PCIBus)
+    {
+        Status = HalpNt5PciLine(Pdo, &Minimum);
+        if (!NT_SUCCESS(Status)) return Status;
+        Maximum = Minimum;
+    }
+    else
+    {
+        Minimum = Source->u.Interrupt.MinimumVector;
+        Maximum = min(Source->u.Interrupt.MaximumVector, 15);
+    }
+    for (Line = Minimum; Line <= Maximum; ++Line)
+    {
+        Vector = HalpNt5TranslateLine(Line, &Irql, &Affinity);
+        if (Vector) Vectors[Count++] = Vector;
+    }
+    if (!Count) return STATUS_UNSUCCESSFUL;
+    Result = ExAllocatePoolWithTag(PagedPool, Count * sizeof(*Result), TAG_HAL);
+    if (!Result) return STATUS_INSUFFICIENT_RESOURCES;
+    for (Line = 0; Line < Count; ++Line)
+    {
+        Result[Line] = *Source;
+        if ((ULONG_PTR)Context == PCIBus)
+            Result[Line].Flags = HalpNt5PciInterruptFlags(Source->Flags, Minimum);
+        if (Line) Result[Line].Option |= IO_RESOURCE_ALTERNATIVE;
+        Result[Line].u.Interrupt.MinimumVector = Vectors[Line];
+        Result[Line].u.Interrupt.MaximumVector = Vectors[Line];
+    }
+    *Target = Result;
+    *TargetCount = Count;
+    return STATUS_TRANSLATION_COMPLETE;
+}
+
+NTSTATUS NTAPI
+HalpNt5GetInterruptTranslator(INTERFACE_TYPE Parent, ULONG ParentBus,
+                             INTERFACE_TYPE Bridge, USHORT Size, USHORT Version,
+                             PTRANSLATOR_INTERFACE Translator, PULONG BridgeBus)
+{
+    if (!Translator || Size < sizeof(*Translator) || Version != 0)
+        return STATUS_INVALID_PARAMETER;
+    if (Bridge != PCIBus && Bridge != Isa && Bridge != Eisa &&
+        Bridge != InterfaceTypeUndefined) return STATUS_NOT_IMPLEMENTED;
+    if (Parent != Internal && Parent != PCIBus && Parent != Isa && Parent != Eisa)
+        return STATUS_NOT_IMPLEMENTED;
+    Translator->Size = sizeof(*Translator);
+    Translator->Version = 0;
+    Translator->Context = UlongToPtr(Bridge == PCIBus ? PCIBus : Isa);
+    Translator->InterfaceReference = HalpNt5TranslatorReference;
+    Translator->InterfaceDereference = HalpNt5TranslatorReference;
+    Translator->TranslateResources = HalpNt5TranslateResource;
+    Translator->TranslateResourceRequirements = HalpNt5TranslateRequirements;
+    return STATUS_SUCCESS;
+}
diff --git a/hal/halx86/xboxnt5/trapentry.c b/hal/halx86/xboxnt5/trapentry.c
new file mode 100644
index 0000000000000000000000000000000000000000..a1088d5e43546ef900f4021b58c0b1c9721957be
--- /dev/null
+++ b/hal/halx86/xboxnt5/trapentry.c
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Use the NT5 PCR debug flag, not the newer KTHREAD dispatcher-header byte.
+ * Offsets below are verified against the matching Windows 2000 public PDB.
+ */
+#include <hal.h>
+// The newer shared KPCR no longer names this byte DebugActive.
+#define NT5_PCR_DEBUG_ACTIVE 0x50
+C_ASSERT(FIELD_OFFSET(KPRCB, ProcessorState) == 0x1c);
+C_ASSERT(FIELD_OFFSET(KPRCB, ProcessorState.SpecialRegisters.KernelDr0) == 0x2f8);
+C_ASSERT(FIELD_OFFSET(KPRCB, ProcessorState.SpecialRegisters.KernelDr7) == 0x30c);
+C_ASSERT(FIELD_OFFSET(KTRAP_FRAME, Eip) == 0x68);
+C_ASSERT(FIELD_OFFSET(KTRAP_FRAME, EFlags) == 0x70);
+C_ASSERT(FIELD_OFFSET(KTRAP_FRAME, ExceptionList) == 0x4c);
+C_ASSERT(PRIMARY_VECTOR_BASE + PIC_TIMER_IRQ == 0x30);
+
+VOID FASTCALL HalpNt5EnterTrap(PKTRAP_FRAME TrapFrame)
+{
+    TrapFrame->Dr7 = 0;
+    if ((KiUserTrap(TrapFrame) || (TrapFrame->EFlags & EFLAGS_V86_MASK)) &&
+        *((volatile UCHAR *)KeGetPcr() + NT5_PCR_DEBUG_ACTIVE))
+    {
+        KiHandleDebugRegistersOnTrapEntry(TrapFrame);
+    }
+}
+
+VOID FASTCALL HalpNt5EnterInterruptTrap(PKTRAP_FRAME TrapFrame)
+{
+    KeGetPcr()->NtTib.ExceptionList = EXCEPTION_CHAIN_END;
+    HalpNt5EnterTrap(TrapFrame);
+}
