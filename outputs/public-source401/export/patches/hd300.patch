+static NTSTATUS
+VfatPagingFileIo(PVFAT_IRP_CONTEXT IrpContext, BOOLEAN Write)
+{
+    PVFATFCB Fcb = IrpContext->FileObject->FsContext;
+    PVFAT_PAGING_MAP Map = Fcb->PagingMap;
