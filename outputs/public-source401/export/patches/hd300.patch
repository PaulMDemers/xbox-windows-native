+
+#ifdef XBOX_NT5_BIOS_PREFLIGHT
+extern PFN_NUMBER x86BiosFallbackPfn;
+extern ULONG64 x86BiosBufferPhysical;
+extern BOOLEAN x86BiosIsInitialized;
+extern PUCHAR x86BiosMemoryMapping;
+extern LONG x86BiosBufferIsAllocated;
+extern ULONG HalpUsedAllocDescriptors;
+#ifndef XBOX_NT5_MM_PREFLIGHT
+DECLSPEC_NORETURN
+#endif
+VOID HalpXwnBiosReady(ULONG Phase, PLOADER_PARAMETER_BLOCK LoaderBlock, PVOID Caller)
+{
+    ULONG State[15], Flags = __readeflags(), Count = 0, Reserved = 0;
+    PLIST_ENTRY Link;
+    _disable();
+    if (!XwnPhaseCallback || XwnPhaseStep != 7 || Phase != 0) for (;;) __halt();
+    for (Link = LoaderBlock->MemoryDescriptorListHead.Flink;
+         Link != &LoaderBlock->MemoryDescriptorListHead && Count < 128;
+         Link = Link->Flink)
+    {
+        PMEMORY_ALLOCATION_DESCRIPTOR D = CONTAINING_RECORD(Link, MEMORY_ALLOCATION_DESCRIPTOR, ListEntry);
+        ++Count;
+        if (D->MemoryType == LoaderHALCachedMemory && D->PageCount == 1)
+        {
+            if (D->BasePage == x86BiosFallbackPfn) Reserved |= 1;
+            if (((ULONG64)D->BasePage << PAGE_SHIFT) == x86BiosBufferPhysical) Reserved |= 2;
+        }
+    }
+    State[0] = Phase;
+    State[1] = KeGetPcr()->IDR;
+    State[2] = KeGetPcr()->StallScaleFactor;
+    State[3] = (ULONG)HalpActiveProcessors;
+    State[4] = (ULONG)HalpDefaultInterruptAffinity;
+    State[5] = x86BiosFallbackPfn;
+    State[6] = (ULONG)x86BiosBufferPhysical;
+    State[7] = (ULONG)(x86BiosBufferPhysical >> 32);
+    State[8] = Count;
+    State[9] = HalpUsedAllocDescriptors;
+    State[10] = __inbyte(0x21) | (__inbyte(0xa1) << 8);
+    State[11] = Flags;
+    State[12] = x86BiosIsInitialized | ((x86BiosMemoryMapping != NULL) << 1) | ((x86BiosBufferIsAllocated != 0) << 2);
+    State[13] = Reserved;
+    State[14] = (Link == &LoaderBlock->MemoryDescriptorListHead);
+    XwnPhaseStep = 8;
+#ifdef XBOX_NT5_MM_PREFLIGHT
+    if (XwnPhaseCallback(80, LoaderBlock, Caller, State) == 0x50524330)
+    {
+#ifdef XBOX_NT5_MAP_PREFLIGHT
+        HalpXwnMapSnapshot();
+#endif
+        __writeeflags(Flags);
+        return;
+    }
+#else
+    XwnPhaseCallback(80, LoaderBlock, Caller, State);
+#endif
+    for (;;) __halt();
+}
+#endif
diff --git a/hal/halx86/xboxnt5/fmutex.c b/hal/halx86/xboxnt5/fmutex.c
new file mode 100644
index 0000000000000000000000000000000000000000..c86ca6e49f6aecc341a8af1be46d65ce5dbea292
--- /dev/null
+++ b/hal/halx86/xboxnt5/fmutex.c
@@ -0,0 +1,67 @@
+/*
+ * PROJECT:     Experimental Windows 2000 Xbox HAL
+ * LICENSE:     GPL-2.0-or-later
+ * PURPOSE:     HAL-owned fast mutexes, using NT 5.0 kernel exports.
+ * Derived from ReactOS ntoskrnl/include/internal/ex.h fast-mutex algorithms.
+ * Runtime/ABI validation against Windows 2000 remains required.
+ */
+#include <hal.h>
+#undef ExAcquireFastMutex
+#undef ExReleaseFastMutex
+#undef ExTryToAcquireFastMutex
+
+/* The NT5 x86 FAST_MUTEX ABI; never use a version-specific KTHREAD field. */
+C_ASSERT(NTDDI_VERSION == NTDDI_WIN2K);
+C_ASSERT(HAL_DISPATCH_VERSION == 2);
+C_ASSERT(HAL_PRIVATE_DISPATCH_VERSION == 1);
+C_ASSERT(sizeof(HAL_DISPATCH) == 0x44);
+C_ASSERT(sizeof(HAL_PRIVATE_DISPATCH) == 0x30);
+C_ASSERT(FIELD_OFFSET(HAL_DISPATCH, HalIoAssignDriveLetters) == 0x18);
+C_ASSERT(FIELD_OFFSET(HAL_DISPATCH, HalIoReadPartitionTable) == 0x1c);
+C_ASSERT(FIELD_OFFSET(HAL_DISPATCH, HalIoSetPartitionInformation) == 0x20);
+C_ASSERT(FIELD_OFFSET(HAL_DISPATCH, HalIoWritePartitionTable) == 0x24);
+C_ASSERT(sizeof(FAST_MUTEX) == 32);
+C_ASSERT(FIELD_OFFSET(FAST_MUTEX, Count) == 0);
+C_ASSERT(FIELD_OFFSET(FAST_MUTEX, Owner) == 4);
+C_ASSERT(FIELD_OFFSET(FAST_MUTEX, Contention) == 8);
+C_ASSERT(FIELD_OFFSET(FAST_MUTEX, Event) == 12);
+C_ASSERT(FIELD_OFFSET(FAST_MUTEX, OldIrql) == 28);
+
+VOID FASTCALL
+ExAcquireFastMutex(PFAST_MUTEX Mutex)
+{
+    KIRQL OldIrql;
+    KeRaiseIrql(APC_LEVEL, &OldIrql);
+    if (InterlockedDecrement(&Mutex->Count) != 0)
+    {
+        InterlockedIncrement((PLONG)&Mutex->Contention);
+        KeWaitForSingleObject(&Mutex->Event, Executive, KernelMode, FALSE, NULL);
+    }
+    Mutex->Owner = KeGetCurrentThread();
+    Mutex->OldIrql = OldIrql;
+}
+
+VOID FASTCALL
+ExReleaseFastMutex(PFAST_MUTEX Mutex)
+{
+    KIRQL OldIrql = (KIRQL)Mutex->OldIrql;
+    Mutex->Owner = NULL;
+    if (InterlockedIncrement(&Mutex->Count) <= 0)
+        KeSetEventBoostPriority(&Mutex->Event, NULL);
+    KeLowerIrql(OldIrql);
+}
+
+BOOLEAN FASTCALL
+ExTryToAcquireFastMutex(PFAST_MUTEX Mutex)
+{
+    KIRQL OldIrql;
+    KeRaiseIrql(APC_LEVEL, &OldIrql);
+    if (InterlockedCompareExchange(&Mutex->Count, 0, 1) == 1)
+    {
+        Mutex->Owner = KeGetCurrentThread();
+        Mutex->OldIrql = OldIrql;
+        return TRUE;
+    }
+    KeLowerIrql(OldIrql);
+    return FALSE;
+}
