diff --git a/win32ss/drivers/miniport/xboxvmp/nt5/video_pnp.c b/win32ss/drivers/miniport/xboxvmp/nt5/video_pnp.c
new file mode 100644
index 0000000000000000000000000000000000000000..6cababe4a8ab8daa8e98e1ad046921d9ec9d9ba1
--- /dev/null
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/video_pnp.c
@@ -0,0 +1,92 @@
+/* Experimental NT5 video PnP checkpoint. GPL-2.0-or-later.
+ * Default-off, RAM-only instrumentation of this driver's own callbacks.
+ * Stops BEFORE forwarding START_DEVICE. Never changes PCI configuration. */
+#include <ntddk.h>
+
+static PDRIVER_ADD_DEVICE OriginalAddDevice;
+static PDRIVER_DISPATCH OriginalPnp;
+#ifdef XBOX_NT5_VIDEO_TRACE
+VOID NTAPI XwnVideoTraceInit(VOID);
+VOID NTAPI XwnVideoTrace(ULONG, ULONG, ULONG, ULONG);
+VOID NTAPI XwnVideoTraceClose(VOID);
+VOID NTAPI XwnVideoTracePci(VOID);
+static PDRIVER_UNLOAD OriginalUnload;
+static VOID NTAPI XwnVideoUnload(PDRIVER_OBJECT Driver)
+{
+    XwnVideoTrace(6, 0, 0, 0);
+    XwnVideoTraceClose();
+    if (OriginalUnload) OriginalUnload(Driver);
+#ifdef XBOX_NT5_SHARED_FRAMEBUFFER
+    { VOID NTAPI XwnSharedClose(VOID); XwnSharedClose(); }
+#endif
+}
+#define TRACE(e,a,b,c) XwnVideoTrace(e,(ULONG)(a),(ULONG)(b),(ULONG)(c))
+#else
+#define TRACE(e,a,b,c) ((void)0)
+#endif
+
+static NTSTATUS NTAPI
+XwnVideoPnp(PDEVICE_OBJECT Device, PIRP Irp)
+{
+    PIO_STACK_LOCATION Stack = IoGetCurrentIrpStackLocation(Irp);
+    UCHAR Minor = Stack->MinorFunction;
+    NTSTATUS Status;
+    TRACE(4, Minor, Device, 0);
+    if (Minor == IRP_MN_START_DEVICE)
+    {
+        PCM_RESOURCE_LIST Raw = Stack->Parameters.StartDevice.AllocatedResources;
+        PCM_RESOURCE_LIST Translated = Stack->Parameters.StartDevice.AllocatedResourcesTranslated;
+#ifdef XBOX_NT5_VIDEO_TRACE
+        TRACE(7, Raw ? Raw->Count : 0, Translated ? Translated->Count : 0, 0);
+#else
+        KeBugCheckEx(0xE0580001, 9, Raw ? Raw->Count : 0,
+                     Translated ? Translated->Count : 0, 0x53545254);
+#endif
+    }
+    /* Optional PnP queries may legitimately fail. Preserve their responses.
+     * Do not access Irp after the original dispatch may have completed it. */
+    Status = OriginalPnp(Device, Irp);
+    TRACE(5, Minor, Status, 0);
+    return Status;
+}
+
+static NTSTATUS NTAPI
+XwnVideoAddDevice(PDRIVER_OBJECT Driver, PDEVICE_OBJECT PhysicalDevice)
+{
+    NTSTATUS Status;
+    TRACE(2, PhysicalDevice, 0, 0);
+    Status = OriginalAddDevice(Driver, PhysicalDevice);
+    TRACE(3, Status, PhysicalDevice, 0);
+    if (!NT_SUCCESS(Status))
+        KeBugCheckEx(0xE0580001, 10, (ULONG_PTR)Status,
+                     (ULONG_PTR)PhysicalDevice, 0);
+    /* VideoPort may install its dispatch while creating the device. */
+    if (Driver->MajorFunction[IRP_MJ_PNP] != XwnVideoPnp)
+    {
+        OriginalPnp = Driver->MajorFunction[IRP_MJ_PNP];
+        if (!OriginalPnp)
+            KeBugCheckEx(0xE0580001, 11, 0, 0, 1);
+        Driver->MajorFunction[IRP_MJ_PNP] = XwnVideoPnp;
+    }
+    return Status;
+}
+
+VOID NTAPI XwnVideoArmPnp(PDRIVER_OBJECT Driver)
+{
+#ifdef XBOX_NT5_VIDEO_TRACE
+    XwnVideoTraceInit();
+    OriginalUnload = Driver->DriverUnload;
+    Driver->DriverUnload = XwnVideoUnload;
+#endif
+    OriginalAddDevice = Driver->DriverExtension ? Driver->DriverExtension->AddDevice : NULL;
+    OriginalPnp = Driver->MajorFunction[IRP_MJ_PNP];
+    TRACE(1, OriginalAddDevice, OriginalPnp, 0);
+#ifdef XBOX_NT5_VIDEO_TRACE
+    XwnVideoTracePci();
+#endif
+    if (!OriginalAddDevice || !OriginalPnp)
+        KeBugCheckEx(0xE0580001, 11, (ULONG_PTR)OriginalAddDevice,
+                     (ULONG_PTR)OriginalPnp, 0);
+    Driver->DriverExtension->AddDevice = XwnVideoAddDevice;
+    Driver->MajorFunction[IRP_MJ_PNP] = XwnVideoPnp;
+}
diff --git a/win32ss/drivers/miniport/xboxvmp/nt5/video_shared.c b/win32ss/drivers/miniport/xboxvmp/nt5/video_shared.c
new file mode 100644
index 0000000000000000000000000000000000000000..2883837e1719e7c67746b903472193ffb278bc25
--- /dev/null
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/video_shared.c
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <ntddk.h>
+#include <winerror.h>
+#include "xwn_fb.h"
+VOID NTAPI XwnVideoTrace(ULONG, ULONG, ULONG, ULONG);
+static PVOID SharedOwner;
+ULONG NTAPI XwnSharedMap(PVOID Device, ULONG Ram, ULONG Width, ULONG Height,
+                         ULONG Stride, PVOID *Address)
+{
+    XWN_FB_VIEW View = {0};
+    NTSTATUS Status;
+    if (!Address || *Address) return ERROR_INVALID_PARAMETER;
+    View.Size = sizeof(View); View.Version = XWN_FB_VERSION;
+#ifdef XBOX_NT5_HD_RESERVATION
+    View.ReservedBytes = XWN_FB_BYTES;
+#endif
+    View.Physical = Ram; View.Width = Width; View.Height = Height; View.Stride = Stride;
+    Status = XwnFbAcquire(Device, &View);
+    XwnVideoTrace(0x30, Status, View.Address, View.Physical);
+    if (!NT_SUCCESS(Status)) return ERROR_INVALID_PARAMETER;
+    SharedOwner = Device;
+    *Address = (PVOID)(ULONG_PTR)View.Address;
+    return ERROR_SUCCESS;
+}
+ULONG NTAPI XwnSharedUnmap(PVOID Device, PVOID Address)
+{
+    NTSTATUS Status = XwnFbRelease(Device, Address);
+    XwnVideoTrace(0x31, Status, (ULONG_PTR)Address, (ULONG_PTR)Device);
+    return NT_SUCCESS(Status) ? ERROR_SUCCESS : ERROR_INVALID_PARAMETER;
+}
+VOID NTAPI XwnSharedClose(VOID)
+{
+    if (SharedOwner)
+    {
+        NTSTATUS Status = XwnFbReleaseOwner(SharedOwner);
+        XwnVideoTrace(0x32, Status, (ULONG_PTR)SharedOwner, 0);
+        SharedOwner = NULL;
+    }
+}
diff --git a/win32ss/drivers/miniport/xboxvmp/nt5/video_trace.c b/win32ss/drivers/miniport/xboxvmp/nt5/video_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..ebc8a905e644947d4bb7aa8bb458348adab52805
--- /dev/null
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/video_trace.c
@@ -0,0 +1,101 @@
+/* GPL-2.0-or-later. Opt-in trace to an existing, explicitly seeded 4096-byte file.
+ * No creation, resizing, path selection, PCI writes, or disk-sector access. */
+#include <ntddk.h>
+
+
+static HANDLE TraceHandle;
+static ULONG TraceData[1024];
+static volatile LONG TraceBusy;
+static const CHAR Magic[16] = "XWN-VID-TRACE01\n";
+
+static VOID TraceFail(ULONG Phase, NTSTATUS Status, ULONG_PTR Bytes)
+{
+    KeBugCheckEx(0xE0580001, 13, Phase, (ULONG_PTR)Status, Bytes);
+}
+
+VOID NTAPI XwnVideoTraceInit(VOID)
+{
+    UNICODE_STRING Name;
+    OBJECT_ATTRIBUTES Attributes;
+    IO_STATUS_BLOCK Io;
+    FILE_STANDARD_INFORMATION Info;
+    LARGE_INTEGER Offset;
+    NTSTATUS Status;
+    ULONG I;
+    if (KeGetCurrentIrql() != PASSIVE_LEVEL)
+        TraceFail(0, STATUS_INVALID_DEVICE_STATE, KeGetCurrentIrql());
+    RtlInitUnicodeString(&Name, L"\\SystemRoot\\System32\\xwn-video-trace.bin");
+    InitializeObjectAttributes(&Attributes, &Name,
+                               OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE, NULL, NULL);
+    Status = ZwCreateFile(&TraceHandle, FILE_READ_DATA | FILE_WRITE_DATA | SYNCHRONIZE,
+                          &Attributes, &Io, NULL, 0, FILE_SHARE_READ, FILE_OPEN,
+                          FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT |
+                          FILE_WRITE_THROUGH, NULL, 0);
+    if (!NT_SUCCESS(Status)) TraceFail(1, Status, 0);
+    Status = ZwQueryInformationFile(TraceHandle, &Io, &Info, sizeof(Info), FileStandardInformation);
+    if (!NT_SUCCESS(Status) || Info.EndOfFile.QuadPart != sizeof(TraceData))
+        TraceFail(2, Status, NT_SUCCESS(Status) ? Info.EndOfFile.LowPart : 0);
+    Offset.QuadPart = 0;
+    Io.Information = 0;
+    Status = ZwReadFile(TraceHandle, NULL, NULL, NULL, &Io,
+                        TraceData, sizeof(TraceData), &Offset, NULL);
+    if (!NT_SUCCESS(Status) || Io.Information != sizeof(TraceData))
+        TraceFail(3, Status, Io.Information);
+    for (I = 0; I < sizeof(Magic); ++I)
+        if (((PUCHAR)TraceData)[I] != (UCHAR)Magic[I]) TraceFail(4, STATUS_DATA_ERROR, I);
+#ifdef XBOX_NT5_VIDEO_TRACE_REUSE
+    /* A previous boot's records are expected. Retain marker/length checks and
+     * all file/PCI behavior, then start this boot's in-memory trace empty. */
+    for (I = sizeof(Magic); I < sizeof(TraceData); ++I)
+        ((PUCHAR)TraceData)[I] = 0;
+#else
+    for (I = sizeof(Magic); I < sizeof(TraceData); ++I)
+        if (((PUCHAR)TraceData)[I]) TraceFail(4, STATUS_DATA_ERROR, I);
+#endif
+}
+
+VOID NTAPI XwnVideoTrace(ULONG Event, ULONG A, ULONG B, ULONG C)
+{
+    LARGE_INTEGER Offset;
+    IO_STATUS_BLOCK Io;
+    NTSTATUS Status;
+    ULONG Index;
+    if (!TraceHandle) return;
+    if (KeGetCurrentIrql() != PASSIVE_LEVEL ||
+        InterlockedCompareExchange(&TraceBusy, 1, 0) != 0)
+    {
+        InterlockedIncrement((PLONG)&TraceData[5]);
+        return;
+    }
+    if (TraceData[4] >= 254) { InterlockedExchange(&TraceBusy, 0); return; }
+    Index = 8 + TraceData[4] * 4;
+    TraceData[Index] = Event; TraceData[Index + 1] = A;
+    TraceData[Index + 2] = B; TraceData[Index + 3] = C;
+    ++TraceData[4];
+    Offset.QuadPart = 0;
+    Io.Information = 0;
+    Status = ZwWriteFile(TraceHandle, NULL, NULL, NULL, &Io,
+                         TraceData, sizeof(TraceData), &Offset, NULL);
+    if (!NT_SUCCESS(Status) || Io.Information != sizeof(TraceData))
+        TraceFail(5, Status, Io.Information);
+    InterlockedExchange(&TraceBusy, 0);
+}
+
+VOID NTAPI XwnVideoTraceClose(VOID)
+{
+    if (TraceHandle) { ZwClose(TraceHandle); TraceHandle = NULL; }
+}
+
+
+VOID NTAPI XwnVideoTracePci(VOID)
+{
+    ULONG Bridge[16], Gpu[16], I, BridgeBytes, GpuBytes;
+    RtlFillMemory(Bridge, sizeof(Bridge), 0xff);
+    RtlFillMemory(Gpu, sizeof(Gpu), 0xff);
+    /* Xbox AGP bridge 00:1e.0 and GPU 01:00.0; config reads only. */
+    BridgeBytes = HalGetBusDataByOffset(PCIConfiguration, 0, 30, Bridge, 0, sizeof(Bridge));
+    GpuBytes = HalGetBusDataByOffset(PCIConfiguration, 1, 0, Gpu, 0, sizeof(Gpu));
+    XwnVideoTrace(8, BridgeBytes, GpuBytes, 0);
+    for (I = 0; I < 16; ++I)
+        XwnVideoTrace(9, I * 4, Bridge[I], Gpu[I]);
+}
diff --git a/win32ss/drivers/miniport/xboxvmp/nt5/xboxvnt5.c b/win32ss/drivers/miniport/xboxvmp/nt5/xboxvnt5.c
new file mode 100644
index 0000000000000000000000000000000000000000..898dac98d01fe024a8fee612fa7c31bb9223d724
--- /dev/null
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/xboxvnt5.c
@@ -0,0 +1,228 @@
+/*
+ * PROJECT: Experimental native Windows 2000 Xbox framebuffer miniport
+ * LICENSE: GPL-2.0-or-later
+ * Derived from ReactOS xboxvmp (Ge van Geldorp, Filip Navara,
+ * Stanislav Motylkov). See ../xboxvmp.c and ReactOS COPYING.
+ * Retains firmware's mode; no acceleration, palette or mode switching.
+ */
+#include "../xboxvmp.h"
+#include <drivers/xbox/xgpu.h>
+#ifdef XBOX_NT5_SHARED_FRAMEBUFFER
+ULONG NTAPI XwnSharedMap(PVOID, ULONG, ULONG, ULONG, ULONG, PVOID *);
+ULONG NTAPI XwnSharedUnmap(PVOID, PVOID);
+#endif
+
+#ifdef XBOX_NT5_VIDEO_DIAGNOSTIC
+/* Deliberate diagnostic stop: preserve the first failing native video stage.
+ * Stage 1: VideoPortInitialize; 2: PCI ranges; 3: range sizes; 4: register map;
+ * 5: firmware geometry; 6: aperture bounds; 7: framebuffer map.
+ * No GPU mode changes or disk writes are introduced by this diagnostic. */
+NTSYSAPI VOID NTAPI KeBugCheckEx(ULONG, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR);
+#define VIDEO_FAIL(stage, a, b, c) KeBugCheckEx(0xE0580001, stage, a, b, c)
+#else
+#define VIDEO_FAIL(stage, a, b, c) ((void)0)
+#endif
+
+typedef struct {
+    PVOID Control;
+    PHYSICAL_ADDRESS ControlPhysical, FramebufferAperture, Framebuffer;
+    ULONG ApertureLength, Offset;
+    VIDEO_MODE_INFORMATION Mode;
+    BOOLEAN Ready;
+} NT5_VIDEO, *PNT5_VIDEO;
+
+C_ASSERT(SIZE_OF_W2K_VIDEO_HW_INITIALIZATION_DATA == 80);
+C_ASSERT(sizeof(VIDEO_MODE_INFORMATION) == 80);
+C_ASSERT(sizeof(VIDEO_MEMORY_INFORMATION) == 16);
+
+static UCHAR Crtc(PNT5_VIDEO V, UCHAR Index)
+{
+    WRITE_REGISTER_UCHAR((PUCHAR)V->Control + NV2A_CRTC_REGISTER_INDEX, Index);
+    return READ_REGISTER_UCHAR((PUCHAR)V->Control + NV2A_CRTC_REGISTER_VALUE);
+}
+
+VP_STATUS NTAPI
+Nt5VideoFindAdapter(PVOID Extension, PVOID Context, PWSTR Arguments,
+                   PVIDEO_PORT_CONFIG_INFO Config, PUCHAR Again)
+{
+    PNT5_VIDEO V = Extension;
+    VIDEO_ACCESS_RANGE Ranges[3];
+    USHORT Vendor = 0x10de, Device = 0x02a0;
+    ULONG Slot = 0;
+    VP_STATUS Status;
+    *Again = FALSE;
+    VideoPortZeroMemory(Ranges, sizeof(Ranges));
+    Status = VideoPortGetAccessRanges(Extension, 0, NULL, 3, Ranges, &Vendor, &Device, &Slot);
+    if (Status != NO_ERROR) { VIDEO_FAIL(2, Status, Config->SystemIoBusNumber, Slot); return Status; }
+    if (Ranges[0].RangeInIoSpace || Ranges[1].RangeInIoSpace ||
+        Ranges[0].RangeLength < NV2A_RAMDAC_FP_HVALID_END + sizeof(ULONG) ||
+        Ranges[1].RangeLength < NV2A_VIDEO_MEMORY_SIZE)
+    { VIDEO_FAIL(3, Ranges[0].RangeLength, Ranges[1].RangeLength,
+                 Ranges[0].RangeInIoSpace | (Ranges[1].RangeInIoSpace << 8));
+      return ERROR_DEV_NOT_EXIST; }
+    V->ControlPhysical = Ranges[0].RangeStart;
+    V->FramebufferAperture = Ranges[1].RangeStart;
+    V->ApertureLength = Ranges[1].RangeLength;
+#ifdef XBOX_NT5_VIDEO_ADAPTER_DIAGNOSTIC
+    /* Preserve Windows-assigned resources before hardware initialization. */
+    VIDEO_FAIL(8, V->ControlPhysical.LowPart,
+               V->FramebufferAperture.LowPart, V->ApertureLength);
+#endif
+    return NO_ERROR;
+}
+
+BOOLEAN NTAPI
+Nt5VideoInitialize(PVOID Extension)
+{
+    PNT5_VIDEO V = Extension;
+    ULONG Width, Height, Pitch, Bytes, Format;
+    V->Ready = FALSE;
+    V->Control = VideoPortGetDeviceBase(Extension, V->ControlPhysical, 0x681000, 0);
+    if (!V->Control) { VIDEO_FAIL(4, V->ControlPhysical.LowPart, V->ControlPhysical.HighPart, 0); return FALSE; }
+    Width = READ_REGISTER_ULONG((PULONG)((PUCHAR)V->Control + NV2A_RAMDAC_FP_HVALID_END)) + 1;
+    Height = READ_REGISTER_ULONG((PULONG)((PUCHAR)V->Control + NV2A_RAMDAC_FP_VVALID_END)) + 1;
+    Pitch = 8 * (((Crtc(V, 0x19) & 0xe0) << 3) | Crtc(V, 0x13));
+    Format = Crtc(V, 0x28) & 15;
+    Bytes = (Format == 3) ? 4 : Format;
+    V->Offset = READ_REGISTER_ULONG((PULONG)((PUCHAR)V->Control + NV2A_CRTC_FRAMEBUFFER_START)) & 0x0fffffff;
+    /* This experiment supports the firmware's direct RGB mode only. The
+       framebuffer must stay inside Cromwell's reserved top-four-MiB area. */
+    if (Width < 320 || Width > 1920 || Height < 200 || Height > 1080 || Bytes != 4 ||
+        Pitch < Width * Bytes || Pitch > 8192 || Height > NV2A_VIDEO_MEMORY_SIZE / Pitch ||
+#ifdef XBOX_NT5_HD_RESERVATION
+        !XwnHdLayoutValid(V->Offset, NV2A_VIDEO_MEMORY_SIZE, Width, Height, Pitch, XWN_HD_HIDDEN_OFFSET) ||
+#else
+        (V->Offset != 0x03c00000 && V->Offset != 0x07c00000) ||
+#endif
+        V->Offset > V->ApertureLength - NV2A_VIDEO_MEMORY_SIZE)
+    {
+        if (Width < 320 || Width > 1920 || Height < 200 || Height > 1080 || Bytes != 4 ||
+            Pitch < Width * Bytes || Pitch > 8192 || Height > NV2A_VIDEO_MEMORY_SIZE / Pitch)
+            VIDEO_FAIL(5, Width, Height, (Pitch << 8) | Format);
+        else
+            VIDEO_FAIL(6, V->Offset, V->ApertureLength, V->FramebufferAperture.LowPart);
+        VideoPortFreeDeviceBase(Extension, V->Control);V->Control = NULL;return FALSE;
+    }
+    V->Framebuffer.QuadPart = V->FramebufferAperture.QuadPart + V->Offset;
+    VideoPortZeroMemory(&V->Mode, sizeof(V->Mode));
+    V->Mode.Length = sizeof(V->Mode);
+    V->Mode.VisScreenWidth = Width; V->Mode.VisScreenHeight = Height;
+    V->Mode.ScreenStride = Pitch; V->Mode.NumberOfPlanes = 1; V->Mode.BitsPerPlane = 32;
+    V->Mode.Frequency = 60;
+    /* No EDID is available for the retained firmware mode. Supply a 96-DPI
+     * logical size: NT5 framebuf passes these fields to GDI, and Paint divides
+     * by HORZSIZE/VERTSIZE when converting between pixels and physical units.
+     * These are fallback dimensions, not measurements of the connected TV. */
+    V->Mode.XMillimeter = (Width * 254 + 480) / 960;
+    V->Mode.YMillimeter = (Height * 254 + 480) / 960;
+    V->Mode.NumberRedBits = V->Mode.NumberGreenBits = V->Mode.NumberBlueBits = 8;
+    V->Mode.RedMask = 0xff0000; V->Mode.GreenMask = 0xff00; V->Mode.BlueMask = 0xff;
+    V->Mode.AttributeFlags = VIDEO_MODE_GRAPHICS | VIDEO_MODE_COLOR | VIDEO_MODE_NO_OFF_SCREEN;
+    V->Mode.VideoMemoryBitmapWidth = Pitch / 4; V->Mode.VideoMemoryBitmapHeight = Height;
+    V->Ready = TRUE;
+    return TRUE;
+}
+
+BOOLEAN NTAPI
+Nt5VideoStartIO(PVOID Extension, PVIDEO_REQUEST_PACKET Request)
+{
+    PNT5_VIDEO V = Extension;
+    VP_STATUS Status = ERROR_INVALID_FUNCTION;
+    Request->StatusBlock->Information = 0;
+    if (!V->Ready) { Request->StatusBlock->Status = ERROR_DEV_NOT_EXIST; return TRUE; }
+    switch (Request->IoControlCode)
+    {
+    case IOCTL_VIDEO_QUERY_NUM_AVAIL_MODES:
+        if (!Request->OutputBuffer || Request->OutputBufferLength < sizeof(VIDEO_NUM_MODES))
+            { Status = ERROR_INSUFFICIENT_BUFFER; break; }
+        ((PVIDEO_NUM_MODES)Request->OutputBuffer)->NumModes = 1;
+        ((PVIDEO_NUM_MODES)Request->OutputBuffer)->ModeInformationLength = sizeof(V->Mode);
+        Request->StatusBlock->Information = sizeof(VIDEO_NUM_MODES);Status = NO_ERROR;break;
+    case IOCTL_VIDEO_QUERY_AVAIL_MODES:
+    case IOCTL_VIDEO_QUERY_CURRENT_MODE:
+        if (!Request->OutputBuffer || Request->OutputBufferLength < sizeof(V->Mode))
+            { Status = ERROR_INSUFFICIENT_BUFFER; break; }
+        *(PVIDEO_MODE_INFORMATION)Request->OutputBuffer = V->Mode;
+        Request->StatusBlock->Information = sizeof(V->Mode);Status = NO_ERROR;break;
+    case IOCTL_VIDEO_SET_CURRENT_MODE:
+        if (!Request->InputBuffer || Request->InputBufferLength < sizeof(VIDEO_MODE))
+            { Status = ERROR_INSUFFICIENT_BUFFER; break; }
+        Status = (((PVIDEO_MODE)Request->InputBuffer)->RequestedMode &
+                  ~(VIDEO_MODE_MAP_MEM_LINEAR | VIDEO_MODE_NO_ZERO_MEMORY)) ? ERROR_INVALID_PARAMETER : NO_ERROR;
+        break;
+    case IOCTL_VIDEO_RESET_DEVICE:
+        Status = NO_ERROR;break;
+    case IOCTL_VIDEO_MAP_VIDEO_MEMORY:
+        if (!Request->InputBuffer || !Request->OutputBuffer ||
+            Request->InputBufferLength < sizeof(VIDEO_MEMORY) ||
+            Request->OutputBufferLength < sizeof(VIDEO_MEMORY_INFORMATION))
+            { Status = ERROR_INSUFFICIENT_BUFFER; break; }
+        {
+            VIDEO_MEMORY_INFORMATION Result;
+#ifndef XBOX_NT5_SHARED_FRAMEBUFFER
+            ULONG Space = VIDEO_MEMORY_SPACE_MEMORY;
+#endif
+            VideoPortZeroMemory(&Result, sizeof(Result));
+            Result.VideoRamBase = ((PVIDEO_MEMORY)Request->InputBuffer)->RequestedVirtualAddress;
+            Result.VideoRamLength = NV2A_VIDEO_MEMORY_SIZE;
+#ifdef XBOX_NT5_SHARED_FRAMEBUFFER
+            Status = XwnSharedMap(Extension, V->Offset, V->Mode.VisScreenWidth,
+                                  V->Mode.VisScreenHeight, V->Mode.ScreenStride, &Result.VideoRamBase);
+#else
+            Status = VideoPortMapMemory(Extension, V->Framebuffer, &Result.VideoRamLength,
+                                        &Space, &Result.VideoRamBase);
+#endif
+            if (Status != NO_ERROR) { VIDEO_FAIL(7, Status, V->Framebuffer.LowPart, Result.VideoRamLength); break; }
+            Result.FrameBufferBase = Result.VideoRamBase;
+            Result.FrameBufferLength = V->Mode.ScreenStride * V->Mode.VisScreenHeight;
+            *(PVIDEO_MEMORY_INFORMATION)Request->OutputBuffer = Result;
+            Request->StatusBlock->Information = sizeof(Result);
+        }
+        break;
+    case IOCTL_VIDEO_UNMAP_VIDEO_MEMORY:
+        if (!Request->InputBuffer || Request->InputBufferLength < sizeof(VIDEO_MEMORY))
+            { Status = ERROR_INSUFFICIENT_BUFFER; break; }
+#ifdef XBOX_NT5_SHARED_FRAMEBUFFER
+        Status = XwnSharedUnmap(Extension, ((PVIDEO_MEMORY)Request->InputBuffer)->RequestedVirtualAddress);
+#else
+        Status = VideoPortUnmapMemory(Extension, ((PVIDEO_MEMORY)Request->InputBuffer)->RequestedVirtualAddress, NULL);
+#endif
+        break;
+    }
+    Request->StatusBlock->Status = Status;
+    return TRUE;
+}
+
+BOOLEAN NTAPI Nt5VideoReset(PVOID Extension, ULONG Columns, ULONG Rows) { return TRUE; }
+VP_STATUS NTAPI Nt5VideoPower(PVOID Extension, ULONG Id, PVIDEO_POWER_MANAGEMENT Power)
+{ return Power->PowerState == VideoPowerOn ? NO_ERROR : ERROR_INVALID_FUNCTION; }
+VP_STATUS NTAPI Nt5VideoChild(PVOID Extension, PVIDEO_CHILD_ENUM_INFO Info,
+                             PVIDEO_CHILD_TYPE Type, PUCHAR Descriptor, PULONG Id, PULONG Unused)
+{ return VIDEO_ENUM_NO_MORE_DEVICES; }
+
+#ifdef XBOX_NT5_VIDEO_PNP_DIAGNOSTIC
+VOID NTAPI XwnVideoArmPnp(PVOID Driver);
+#endif
+ULONG NTAPI DriverEntry(PVOID Context1, PVOID Context2)
+{
+    VIDEO_HW_INITIALIZATION_DATA Init;
+    ULONG Status;
+#ifdef XBOX_NT5_VIDEO_ENTRY_DIAGNOSTIC
+    /* Prove invocation independently of PnP or VideoPort callbacks. */
+    VIDEO_FAIL(0, (ULONG_PTR)Context1, (ULONG_PTR)Context2, 0x56454E54);
+#endif
+    VideoPortZeroMemory(&Init, sizeof(Init));
+    Init.HwInitDataSize = SIZE_OF_W2K_VIDEO_HW_INITIALIZATION_DATA;
+    Init.AdapterInterfaceType = PCIBus;
+    Init.HwDeviceExtensionSize = sizeof(NT5_VIDEO);
+    Init.HwFindAdapter = Nt5VideoFindAdapter; Init.HwInitialize = Nt5VideoInitialize;
+    Init.HwStartIO = Nt5VideoStartIO; Init.HwResetHw = Nt5VideoReset;
+    Init.HwGetPowerState = Nt5VideoPower; Init.HwSetPowerState = Nt5VideoPower;
+    Init.HwGetVideoChildDescriptor = Nt5VideoChild;
+    Status = VideoPortInitialize(Context1, Context2, &Init, NULL);
+    if (Status != NO_ERROR) VIDEO_FAIL(1, Status, 0, 0);
+#ifdef XBOX_NT5_VIDEO_PNP_DIAGNOSTIC
+    if (Status == NO_ERROR) XwnVideoArmPnp(Context1);
+#endif
+    return Status;
+}
diff --git a/win32ss/drivers/miniport/xboxvmp/nt5/xwn_fb.h b/win32ss/drivers/miniport/xboxvmp/nt5/xwn_fb.h
new file mode 100644
index 0000000000000000000000000000000000000000..9bb8ed582d6fc976cbf5ae2e626eb018e8db5031
--- /dev/null
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/xwn_fb.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#ifdef XBOX_NT5_HD_RESERVATION
+#include <drivers/xbox/xwn_hd_layout.h>
+#define XWN_FB_VERSION 2
+#define XWN_FB_BYTES XWN_HD_FB_BYTES
+#else
+#define XWN_FB_VERSION 1
+#define XWN_FB_BYTES 0x00400000
+#endif
+#define XWN_FB_MAX_REFS 0x7fffffff
+typedef struct _XWN_FB_VIEW {
+    ULONG Size, Version, Address, Physical, ReservedBytes, VisibleBytes;
+    ULONG Width, Height, Stride, HiddenOffset, CacheType;
+} XWN_FB_VIEW, *PXWN_FB_VIEW;
+C_ASSERT(sizeof(XWN_FB_VIEW) == 44);
+BOOLEAN NTAPI XwnFbPublish(const XWN_FB_VIEW *View);
+NTSTATUS NTAPI XwnFbAcquire(PVOID Owner, PXWN_FB_VIEW View);
+NTSTATUS NTAPI XwnFbRelease(PVOID Owner, PVOID Address);
+NTSTATUS NTAPI XwnFbReleaseOwner(PVOID Owner);
