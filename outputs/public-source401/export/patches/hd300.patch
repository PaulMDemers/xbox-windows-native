+#endif
+    {
+        XwnEntryRecord[3] = 40;
+        XwnEntryRecord[22] = 3;
+        XwnPagingClear();
+        XwnPagingText(7, "XWNMFAIL: Pinned kernel checkpoint bytes do not match.", 0xFFFF0000);
+        _disable(); for (;;) __halt();
+    }
+#ifdef XBOX_NATIVE_FATX_MAP_PREFLIGHT
+    }
+#endif
+#endif
+    XwnPagingClear();
+#if defined(XBOX_NATIVE_FATX_MMCOMPLETE_PREFLIGHT)
+    XwnPagingText(7,"XWN230: Entering Windows; MM phase-zero stop armed.",0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_PROCESSINIT_PREFLIGHT)
+    XwnPagingText(7,"XWNW30: Entering Windows; process-init stop armed.",0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_PROCESSPAGES_PREFLIGHT)
+    XwnPagingText(7, "XWNZ30: Entering Windows; process-page stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_SYSPTES_PREFLIGHT)
+    XwnPagingText(7, "XWNY30: Entering Windows; system-PTE stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_FREELIST_PREFLIGHT)
+    XwnPagingText(7, "XWNG30: Entering Windows; free-list stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_PFNCOMMIT_PREFLIGHT)
+    XwnPagingText(7, "XWNJ30: Entering Windows; descriptor stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_PFNMAP_PREFLIGHT)
+    XwnPagingText(7, "XWNL30: Entering Windows; mapped-PFN stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_PFN_PREFLIGHT)
+    XwnPagingText(7, "XWNE30: Entering Windows; PFN-backing stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_POOLINIT_PREFLIGHT)
+    XwnPagingText(7, "XWNU30: Entering Windows; pool-initialization stop armed.", 0xFFFFFF00);
+#elif defined(XBOX_NATIVE_FATX_POOL_PREFLIGHT)
