+/* Pair chain retirement with VfatWrite's shared paging acquisition. */
+static NTSTATUS
+FATXDelEntry(
+    IN PDEVICE_EXTENSION DeviceExt,
+    IN PVFATFCB pFcb,
+    OUT PVFAT_MOVE_CONTEXT MoveContext)
+{
+    NTSTATUS Status;
+    if (MoveContext != NULL)
+        return FATXDelEntryLocked(DeviceExt, pFcb, MoveContext);
+
+    ExAcquireResourceExclusiveLite(&pFcb->PagingIoResource, TRUE);
+    Status = FATXDelEntryLocked(DeviceExt, pFcb, NULL);
+    ExReleaseResourceLite(&pFcb->PagingIoResource);
+    return Status;
+}
+
 /*
  * move an existing FAT entry
  */
