+++ b/target/i386/tcg/xwn-sites.h
@@ -0,0 +1,30 @@
+/* Generated from reviewed owned-binary sites; see sites.json. */
+typedef struct XwnSite { uint32_t pc; uint8_t size, kind, bytes[8]; } XwnSite;
+static const XwnSite xwn_sites[] = {
+    {0x82473a84, 3, 5, {0x55,0x8b,0xec}},
+    {0x82473516, 3, 5, {0x55,0x8b,0xec}},
+    {0x8246f4cc, 3, 6, {0x8b,0x44,0x24}},
+    {0x767a5959, 3, 0, {0x83,0x7c,0x24}},
+    {0x767a66d8, 6, 1, {0xff,0x15,0x4c,0x10,0x7a,0x76}},
+    {0x767a66de, 2, 1, {0x85,0xc0}},
+    {0x767a66f0, 6, 1, {0xff,0xb5,0x88,0xfd,0xff,0xff}},
+    {0x824c2c74, 3, 4, {0x53,0x55,0x56}},
+    {0x824c235e, 7, 2, {0x81,0x7d,0xc,0x4,0x0,0x1,0x40}},
+    {0x824c45bd, 3, 3, {0xff,0x75,0xdc}},
+    {0xa007e409, 6, 0, {0xff,0x15,0x8,0x49,0x16,0xa0}},
+};
+static int xwn_site_for_pc(uint64_t pc)
+{
+    static int enabled = -1;
+    if (enabled < 0) { const char *p = getenv("XWN_NATIVE_EVENT_LOG"); enabled = p && *p; }
+    if (!enabled) { return -1; }
+    for (unsigned i = 0; i < ARRAY_SIZE(xwn_sites); ++i) { if (pc == xwn_sites[i].pc) { return i; } }
+    return -1;
+}
+#define XWN_PROCESS_CR3 0x18
+#define XWN_PROCESS_PEB 0x1b0
+#define XWN_PROCESS_PID 0x9c
+#define XWN_PROCESS_IMAGE 0x1fc
+#define XWN_THREAD_OWNER 0x22c
+#define XWN_TICK 0x8244bb84
+#define XWN_TOKEN 0x767b5b64
--- /dev/null
+++ b/target/i386/tcg/xwn-recorder.c.inc
@@ -0,0 +1,146 @@
+/* Owned NT5 experiment: bounded, read-only TCG event capture. Not an OS fix. */
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "qemu/cutils.h"
+#include "xwn-sites.h"
+
+typedef struct XwnRecord {
+    uint32_t seq, site, pc, tick, cr3, regs[8];
+    uint32_t thread, owner, pid, target, target_pid, valid;
+    uint8_t code[8], image[16], command[512], stack[64];
+    uint8_t extra[576], target_command[512];
+} XwnRecord;
+
+static XwnRecord xwn_records[4096];
+static unsigned xwn_count, xwn_flushed;
+static FILE *xwn_file;
+static bool xwn_open_attempted;
+
+/* Physical reads are restricted to the Xbox's low 64 MiB RAM, never MMIO. */
+static bool xwn_phys(uint32_t pa, void *dst, unsigned n)
+{
+    return n <= 0x4000000 && pa <= 0x4000000 - n &&
+        address_space_read(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                           dst, n) == MEMTX_OK;
+}
+
+static bool xwn_read(uint32_t cr3, uint32_t va, void *dst, unsigned n)
+{
+    uint8_t *out = dst;
+    if (n > 4096 || va < 0x10000 || (uint64_t)va + n > 0x100000000ULL) {
+        return false;
+    }
+    while (n) {
+        uint32_t pde, pte, pa;
+        unsigned part = MIN(n, 4096 - (va & 4095));
+        if (!xwn_phys((cr3 & 0xfffff000) + 4 * (va >> 22), &pde, 4) || !(pde & 1)) {
+            return false;
+        }
+        if (pde & 128) {
+            pa = (pde & 0xffc00000) + (va & 0x3fffff);
+        } else {
+            if (!xwn_phys((pde & 0xfffff000) + 4 * ((va >> 12) & 1023), &pte, 4) || !(pte & 1)) {
+                return false;
+            }
+            pa = (pte & 0xfffff000) + (va & 4095);
+        }
+        if (!xwn_phys(pa, out, part)) { return false; }
+        out += part; va += part; n -= part;
+    }
+    return true;
+}
+
+static bool xwn_u32(uint32_t cr3, uint32_t va, uint32_t *value)
+{
+    return xwn_read(cr3, va, value, 4);
+}
+
+/* Each command is read through its owner's CR3. Nonresident data stays unknown. */
+static bool xwn_command(uint32_t current_cr3, uint32_t process, uint8_t *out)
+{
+    uint32_t cr3, peb, params, flags, buffer;
+    uint16_t lengths[2];
+    if (!xwn_u32(current_cr3, process + XWN_PROCESS_CR3, &cr3) ||
+        !xwn_u32(current_cr3, process + XWN_PROCESS_PEB, &peb) ||
+        peb >= 0x80000000 || !xwn_u32(cr3, peb + 0x10, &params) ||
+        params >= 0x80000000 || !xwn_u32(cr3, params + 8, &flags) ||
+        !xwn_read(cr3, params + 0x40, lengths, 4) ||
+        !xwn_u32(cr3, params + 0x44, &buffer) ||
+        lengths[0] > lengths[1] || lengths[0] > 510 || (lengths[0] & 1)) {
+        return false;
+    }
+    if (!(flags & 1)) {
+        if ((uint64_t)buffer + params >= 0x80000000) { return false; }
+        buffer += params;
+    }
+    return buffer < 0x80000000 && xwn_read(cr3, buffer, out, lengths[0]);
+}
+
+static void xwn_flush(void)
+{
+    if (xwn_file && xwn_count > xwn_flushed) {
+        unsigned n = xwn_count - xwn_flushed;
+        size_t written = fwrite(xwn_records + xwn_flushed, sizeof(XwnRecord), n, xwn_file);
+        xwn_flushed += written;
+        fflush(xwn_file);
+        if (written != n) { fprintf(stderr, "XWN recorder short write\n"); }
+    }
+}
+
+void helper_xwn_event(CPUX86State *env, uint32_t site)
+{
+    const XwnSite *s = &xwn_sites[site];
+    XwnRecord *r;
+    uint32_t process = 0, t = 0;
+    if (!xwn_open_attempted) {
+        const char *path = getenv("XWN_NATIVE_EVENT_LOG");
+        uint32_t record_size = sizeof(XwnRecord);
+        xwn_open_attempted = true;
+        if (path && *path) {
+            int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_BINARY, 0600);
+            if (fd >= 0) { xwn_file = fdopen(fd, "wb"); }
+            if (!xwn_file) { fprintf(stderr, "XWN recorder cannot create exclusive output\n"); }
+        }
+        if (xwn_file) {
+            fwrite("XWNEVT01", 1, 8, xwn_file);
+            fwrite(&record_size, 4, 1, xwn_file);
+            fflush(xwn_file);
+            atexit(xwn_flush);
+        }
+    }
+    if (!xwn_file || xwn_count == ARRAY_SIZE(xwn_records)) { return; }
+    r = &xwn_records[xwn_count];
+    r->seq = xwn_count++; r->site = site; r->pc = s->pc; r->cr3 = env->cr[3];
+    for (int i = 0; i < 8; ++i) { r->regs[i] = env->regs[i]; }
+    if (xwn_read(r->cr3, s->pc, r->code, s->size) && !memcmp(r->code, s->bytes, s->size)) { r->valid |= 1; }
+    if (xwn_u32(r->cr3, XWN_TICK, &r->tick)) { r->valid |= 2; }
+    if (xwn_read(r->cr3, r->regs[R_ESP], r->stack, sizeof(r->stack))) { r->valid |= 4; }
+    if (xwn_u32(r->cr3, 0xffdff124, &r->thread) &&
+        xwn_u32(r->cr3, r->thread + XWN_THREAD_OWNER, &r->owner) &&
+        xwn_u32(r->cr3, r->owner + XWN_PROCESS_PID, &r->pid) &&
+        xwn_read(r->cr3, r->owner + XWN_PROCESS_IMAGE, r->image, 16)) { r->valid |= 8; }
+    if (xwn_command(r->cr3, r->owner, r->command)) { r->valid |= 16; }
+    /* Extra data is raw, interpreted only after exact site-byte verification. */
+    if (s->kind == 1) {
+        if (xwn_read(r->cr3, r->regs[R_EBP] - 0x278, r->extra, 576)) { r->valid |= 32; }
+        if (xwn_u32(r->cr3, XWN_TOKEN, &t)) { memcpy(r->extra + 568, &t, 4); r->valid |= 256; }
+        if (xwn_u32(r->cr3, r->thread + 0x20, &t) && xwn_u32(r->cr3, t + 0x34, &t)) {
+            memcpy(r->extra + 572, &t, 4); r->valid |= 512;
+        }
+    } else if (s->kind == 2) {
+        if (xwn_u32(r->cr3, r->regs[R_EBP] - 8, &process)) { r->target = process; }
+        if (xwn_read(r->cr3, r->regs[R_EBP] + 8, r->extra, 8)) { r->valid |= 32; }
+    } else if (s->kind == 3) {
+        if (xwn_u32(r->cr3, r->regs[R_EBP] - 0x24, &t) &&
+            xwn_u32(r->cr3, t + XWN_THREAD_OWNER, &process)) { r->target = process; }
+    } else if (s->kind == 4) {
+        if (xwn_u32(r->cr3, r->regs[R_ESP] + 8, &process)) { r->target = process; }
+    }
+    if (r->target) {
+        if (xwn_u32(r->cr3, process + XWN_PROCESS_PID, &r->target_pid)) { r->valid |= 64; }
+        if (xwn_command(r->cr3, process, r->target_command)) { r->valid |= 128; }
+    }
+    if (xwn_count % 256 == 0 || s->kind == 5 || s->kind == 6 || xwn_count == ARRAY_SIZE(xwn_records)) {
+        xwn_flush();
+    }
+}
