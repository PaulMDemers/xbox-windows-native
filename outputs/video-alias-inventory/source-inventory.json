          "path": "boot/freeldr/freeldr/ntldr/winldr.c",
          "sha256": "74f79b8259632127c9dc8fdff01d616a931c9d450466e3b0dbefab7e7e2a7b46",
          "git_blob": "3a46dce6d14ebdb1070891b341fc71b7438101df",
          "excerpts": [
            {
              "first": 160,
              "last": 230,
              "lines": [
                "    ULONG Width, Height, Pitch, Index, BasePage, Pages, Count = 0;",
                "    UCHAR SavedIndex, LowPitch, HighPitch;",
                "    BOOLEAN Reserved = FALSE;",
                "    PLIST_ENTRY Link, Head = &LoaderBlock->MemoryDescriptorListHead;",
                "    const ULONG Gpu = 0xFD000000;",
                "    Width = READ_REGISTER_ULONG((PULONG)(Gpu + NV2A_RAMDAC_FP_HVALID_END)) + 1;",
                "    Height = READ_REGISTER_ULONG((PULONG)(Gpu + NV2A_RAMDAC_FP_VVALID_END)) + 1;",
                "    SavedIndex = READ_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_INDEX));",
                "    WRITE_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_INDEX), 0x13);",
                "    LowPitch = READ_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_VALUE));",
                "    WRITE_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_INDEX), 0x19);",
                "    HighPitch = READ_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_VALUE));",
                "    WRITE_REGISTER_UCHAR((PUCHAR)(Gpu + NV2A_CRTC_REGISTER_INDEX), SavedIndex);",
                "    Pitch = 8 * (((HighPitch & 0xE0) << 3) | LowPitch);",
                "    XwnDisplayStartRaw = READ_REGISTER_ULONG((PULONG)(Gpu + NV2A_CRTC_FRAMEBUFFER_START));",
                "    XwnPagingFramebuffer = XwnDisplayStartRaw & 0x0FFFFFFF;",
                "    XwnDisplayWidth = Width;",
                "    XwnDisplayHeight = Height;",
                "    XwnDisplayPitch = Pitch;",
                "    XwnLookupPages = MmGetTotalPagesInLookupTable();",
                "    XwnPitchLowRaw = LowPitch;",
                "    XwnPitchHighRaw = HighPitch;",
                "    /* These are the two observed Xromwell modes, both packed 32-bit pixels.",
                "     * Bound dimensions/pitch before multiplication or framebuffer access. */",
                "    if (!((Width == 640 && Height == 480 && Pitch == 2560) ||",
                "          (Width == 1024 && Height == 576 && Pitch == 4096)))",
                "        XwnPagingStop(\"unsupported display geometry\");",
                "    XwnFramebufferBytes = Pitch * Height;",
                "    if ((XwnPagingFramebuffer & 0xFFF) || (XwnFramebufferBytes & 0xFFF) ||",
                "        XwnPagingFramebuffer < 0x03C00000 ||",
                "        XwnPagingFramebuffer > 0x04000000 - XwnFramebufferBytes ||",
                "        XwnLookupPages != 0x3C00)",
                "        XwnPagingStop(\"framebuffer outside reserved RAM layout\");",
                "",
                "    BasePage = XwnPagingFramebuffer >> 12;",
                "    Pages = XwnFramebufferBytes >> 12;",
                "    /* Layout construction already converted the descriptor links to VAs. */",
                "    for (Link = VaToPa(Head->Flink); Link != Head && Count++ < 200;",
                "         Link = VaToPa(Link->Flink))",
                "    {",
                "        PMEMORY_ALLOCATION_DESCRIPTOR D = CONTAINING_RECORD(Link, MEMORY_ALLOCATION_DESCRIPTOR, ListEntry);",
                "        if (D->MemoryType == LoaderFirmwarePermanent && D->BasePage <= BasePage &&",
                "            D->PageCount >= Pages && D->BasePage + D->PageCount >= BasePage + Pages)",
                "            Reserved = TRUE;",
                "    }",
                "    if (!Reserved || Count >= 200) XwnPagingStop(\"framebuffer is not firmware-reserved\");",
                "    /* Only the display window gains an identity mapping; its descriptor stays reserved. */",
                "    if (((PULONG)PDE)[BasePage >> 10] != 0)",
                "        XwnPagingStop(\"unexpected existing display PDE\");",
                "    ((PULONG)PDE)[BasePage >> 10] = (ULONG_PTR)XwnPagingTable | 3;",
                "#ifdef XBOX_NATIVE_FATX_MAP_PREFLIGHT",
                "    /* One reserved framebuffer table, shared by the old identity view and",
                "     * the high diagnostic view. No extra allocation or descriptor change. */",
                "    if (((PULONG)PDE)[(BasePage >> 10) + 512] != 0)",
                "        XwnPagingStop(\"unexpected existing high display PDE\");",
                "    ((PULONG)PDE)[(BasePage >> 10) + 512] = (ULONG_PTR)XwnPagingTable | 3;",
                "#endif",
                "    for (Index = BasePage; Index < BasePage + Pages; ++Index)",
                "    {",
                "        PULONG Pt = (PULONG)(ULONG_PTR)(((PULONG)PDE)[Index >> 10] & ~0xFFF);",
                "        Pt[Index & 1023] = Index * 4096 | 0x1B; /* Present, write, PCD and PWT. */",
                "        if ((Pt[Index & 1023] & ~0xFFF) != Index * 4096 ||",
                "            (Pt[Index & 1023] & 3) != 3) XwnPagingStop(\"framebuffer PTE validation\");",
                "        if (((PULONG)PDE)[(Index >> 10) + 512] & 1)",
                "        {",
                "            Pt = (PULONG)(ULONG_PTR)(((PULONG)PDE)[(Index >> 10) + 512] & ~0xFFF);",
                "            if (Pt[Index & 1023] & 1) Pt[Index & 1023] |= 0x18;",
                "        }",
                "    }",
                "    XwnHandoffRecord[17] = XwnPagingFramebuffer;",
                "    XwnHandoffRecord[18] = XwnFramebufferBytes;"
              ]
            }
          ]
        },
        {
          "path": "boot/freeldr/freeldr/arch/i386/xbox/xboxmem.c",
          "sha256": "48bf0df24da1656778cbb2b0ac7ee95f5d20166c2a7144c1f66ee5e9ed7f75d5",
          "git_blob": "d6bb6a598288a00c2216c54740dae45cc73eaef0",
          "excerpts": [
            {
              "first": 220,
              "last": 280,
              "lines": [
                "        default:",
                "            return LoaderFirmwarePermanent;",
                "    }",
                "}",
                "",
                "static FREELDR_MEMORY_DESCRIPTOR XboxMemoryMap[MAX_BIOS_DESCRIPTORS + 1];",
                "",
                "PFREELDR_MEMORY_DESCRIPTOR",
                "XboxMemGetMemoryMap(ULONG *MemoryMapSize)",
                "{",
                "    memory_map_t * MbMap;",
                "    INT Count, i;",
                "",
                "    TRACE(\"XboxMemGetMemoryMap()\\n\");",
                "",
                "    MbMap = XboxGetMultibootMemoryMap(&Count);",
                "    if (MbMap)",
                "    {",
                "        /* Obtain memory map via multiboot spec */",
                "",
                "        for (i = 0; i < Count; i++, MbMap++)",
                "        {",
                "            TRACE(\"i = %d, base_addr_low = 0x%p, length_low = 0x%p\\n\", i, MbMap->base_addr_low, MbMap->length_low);",
                "",
                "            if (MbMap->base_addr_high > 0 || MbMap->length_high > 0)",
                "            {",
                "                ERR(\"Memory descriptor base or size is greater than 4 GB, should not happen on Xbox!\\n\");",
                "                ASSERT(FALSE);",
                "            }",
                "",
                "            SetMemory(XboxMemoryMap,",
                "                      MbMap->base_addr_low,",
                "                      MbMap->length_low,",
                "                      XboxMultibootMemoryType(MbMap->type));",
                "        }",
                "    }",
                "    else",
                "    {",
                "        /* Synthesize memory map */",
                "",
                "        /* Available RAM block */",
                "        SetMemory(XboxMemoryMap,",
                "                  0,",
                "                  AvailableMemoryMb * 1024 * 1024,",
                "                  LoaderFree);",
                "",
                "        if (FrameBufferSize != 0)",
                "        {",
                "            /* Video memory */",
                "            ReserveMemory(XboxMemoryMap,",
                "                          FrameBuffer,",
                "                          FrameBufferSize,",
                "                          LoaderFirmwarePermanent,",
                "                          \"Video memory\");",
                "        }",
                "    }",
                "",
                "    *MemoryMapSize = PcMemFinalizeMemoryMap(XboxMemoryMap);",
                "    return XboxMemoryMap;",
                "}",
                ""
              ]
            }
          ]
        },
        {
          "path": "drivers/base/bootvid/i386/xbox/bootvid.c",
          "sha256": "13bac8c1886ea71afcbefc4c20475107863f302819ab5d6c18698d594389fbb8",
          "git_blob": "565134a3e3e7dd58775f50a82266983dc5d14b87",
          "excerpts": [
            {
              "first": 120,
              "last": 265,
              "lines": [
                "",
                "    /* FIXME: Add platform check */",
                "    /* 1. Access PCI device 1:0:0 */",
                "    /* 2. Check if device ID is 10DE:02A0 */",
                "",
                "    /* FIXME: Get device MMIO ranges from PCI */",
                "    PHYSICAL_ADDRESS PhysControlStart = {.QuadPart = 0xFD000000};",
                "    PHYSICAL_ADDRESS PhysFrameBufferStart = {.QuadPart = 0xF0000000};",
                "    ULONG ControlLength = 16 * 1024 * 1024;",
                "",
                "    ULONG_PTR ControlStart = (ULONG_PTR)MmMapIoSpace(PhysControlStart, ControlLength, MmNonCached);",
                "    if (!ControlStart)",
                "    {",
                "        DPRINT1(\"Out of memory!\\n\");",
                "        return FALSE;",
                "    }",
                "",
                "    ULONG_PTR FrameBuffer = READ_REGISTER_ULONG((PULONG)(ControlStart + NV2A_CRTC_FRAMEBUFFER_START));",
                "    FrameBufferWidth = READ_REGISTER_ULONG((PULONG)(ControlStart + NV2A_RAMDAC_FP_HVALID_END)) + 1;",
                "    FrameBufferHeight = READ_REGISTER_ULONG((PULONG)(ControlStart + NV2A_RAMDAC_FP_VVALID_END)) + 1;",
                "",
                "    FrameBuffer &= 0x0FFFFFFF;",
                "    if (FrameBuffer != 0x3C00000 && FrameBuffer != 0x7C00000)",
                "    {",
                "        /* Check framebuffer address (high 4 MB of either 64 or 128 MB RAM) */",
                "        DPRINT1(\"Non-standard framebuffer address 0x%p\\n\", FrameBuffer);",
                "    }",
                "    /* Verify that framebuffer address is page-aligned */",
                "    ASSERT(FrameBuffer % PAGE_SIZE == 0);",
                "",
                "    if (FrameBufferWidth < SCREEN_WIDTH || FrameBufferHeight < SCREEN_HEIGHT)",
                "    {",
                "        DPRINT1(\"Unsupported screen resolution!\\n\");",
                "        goto cleanup;",
                "    }",
                "",
                "    BytesPerPixel = NvGetBytesPerPixel(ControlStart, FrameBufferWidth);",
                "    ASSERT(BytesPerPixel >= 1 && BytesPerPixel <= 4);",
                "",
                "    if (BytesPerPixel != 4)",
                "    {",
                "        DPRINT1(\"Unsupported BytesPerPixel = %d\\n\", BytesPerPixel);",
                "        goto cleanup;",
                "    }",
                "",
                "    /* Calculate panning values */",
                "    PanH = (FrameBufferWidth - SCREEN_WIDTH) / 2;",
                "    PanV = (FrameBufferHeight - SCREEN_HEIGHT) / 2;",
                "",
                "    /* Verify that screen fits framebuffer size */",
                "    ULONG FrameBufferSize = FrameBufferWidth * FrameBufferHeight * BytesPerPixel;",
                "",
                "    /* FIXME: obtain fb size from firmware somehow (Cromwell reserves high 4 MB of RAM) */",
                "    if (FrameBufferSize > NV2A_VIDEO_MEMORY_SIZE)",
                "    {",
                "        DPRINT1(\"Current screen resolution exceeds video memory bounds!\\n\");",
                "        goto cleanup;",
                "    }",
                "",
                "    /*",
                "     * Reserve off-screen area for the backbuffer that contains 8-bit indexed",
                "     * color screen image, plus preserved row data.",
                "     */",
                "    ULONG BackBufferSize = SCREEN_WIDTH * (SCREEN_HEIGHT + BOOTCHAR_HEIGHT + 1);",
                "",
                "    /* Make sure there is enough video memory for backbuffer */",
                "    if (NV2A_VIDEO_MEMORY_SIZE - FrameBufferSize < BackBufferSize)",
                "    {",
                "        DPRINT1(\"Out of memory!\\n\");",
                "        goto cleanup;",
                "    }",
                "",
                "    /* Return the address back to GPU memory mapped I/O */",
                "#ifdef XBOX_NT5_BOOTVID",
                "    /* The loader reserves these RAM pages from NT's allocator. The PCI",
                "     * display aperture can be disabled before the final shutdown bitmap,",
                "     * so retain a direct RAM mapping for boot/error/shutdown drawing. */",
                "    PhysFrameBufferStart.QuadPart = FrameBuffer;",
                "#else",
                "    PhysFrameBufferStart.QuadPart += FrameBuffer;",
                "#endif",
                "    FrameBufferStart = (ULONG_PTR)MmMapIoSpace(PhysFrameBufferStart, NV2A_VIDEO_MEMORY_SIZE, MmNonCached);",
                "    if (!FrameBufferStart)",
                "    {",
                "        DPRINT1(\"Out of memory!\\n\");",
                "        goto cleanup;",
                "    }",
                "",
                "    Result = TRUE;",
                "",
                "    /* Place backbuffer in the hidden part of framebuffer */",
                "    BackBuffer = (PUCHAR)(FrameBufferStart + NV2A_VIDEO_MEMORY_SIZE - BackBufferSize);",
                "",
                "    /* Check whether we have to set the video mode */",
                "    if (SetMode)",
                "        VidResetDisplay(TRUE);",
                "",
                "cleanup:",
                "    if (ControlStart)",
                "        MmUnmapIoSpace((PVOID)ControlStart, ControlLength);",
                "",
                "    /* Video is ready */",
                "    return Result;",
                "}",
                "",
                "VOID",
                "NTAPI",
                "VidCleanUp(VOID)",
                "{",
                "    /* Just fill the screen black */",
                "    VidSolidColorFill(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1, BV_COLOR_BLACK);",
                "}",
                "",
                "VOID",
                "ResetDisplay(",
                "    _In_ BOOLEAN SetMode)",
                "{",
                "    /* Reset the video mode with HAL if requested */",
                "    if (SetMode)",
                "        HalResetDisplay();",
                "",
                "    /* Re-initialize the palette and fill the screen black */",
                "    RtlZeroMemory((PULONG)FrameBufferStart, NV2A_VIDEO_MEMORY_SIZE);",
                "    InitializePalette();",
                "    VidSolidColorFill(0, 0, SCREEN_WIDTH - 1, SCREEN_HEIGHT - 1, BV_COLOR_BLACK);",
                "}",
                "",
                "VOID",
                "InitPaletteWithTable(",
                "    _In_reads_(Count) const ULONG* Table,",
                "    _In_ ULONG Count)",
                "{",
                "    const ULONG* Entry = Table;",
                "",
                "    for (ULONG i = 0; i < Count; i++, Entry++)",
                "    {",
                "        CachedPalette[i] = *Entry | 0xFF000000;",
                "    }",
                "    ApplyPalette();",
                "}",
                "",
                "VOID",
                "SetPixel(",
                "    _In_ ULONG Left,",
                "    _In_ ULONG Top,",
                "    _In_ UCHAR Color)"
              ]
            }
          ]
        }
