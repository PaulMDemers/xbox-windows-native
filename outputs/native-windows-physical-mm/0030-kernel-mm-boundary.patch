+#ifdef XBOX_NATIVE_FATX_MM_PREFLIGHT
+    if (!XwnArmMmCheckpoint(Kernel))
+    {
+        XwnEntryRecord[3] = 40;
+        XwnEntryRecord[22] = 3;
+        XwnPagingClear();
+        XwnPagingText(7, "XWNMFAIL: Pinned kernel checkpoint bytes do not match.", 0xFFFF0000);
+        _disable(); for (;;) __halt();
+    }
+#endif
     XwnPagingClear();
-#if defined(XBOX_NATIVE_FATX_BIOS_PREFLIGHT)
+#if defined(XBOX_NATIVE_FATX_MM_PREFLIGHT)
