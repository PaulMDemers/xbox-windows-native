@@ -145,6 +145,14 @@
                 RtlCopyMemory(&DirContext->DirEntry, &rcFcb->entry, sizeof(DIR_ENTRY));
                 DirContext->StartIndex = rcFcb->startIndex;
                 DirContext->DirIndex = rcFcb->dirIndex;
+                /* Cached FATX FCB indices are physical slots. Directory queries
