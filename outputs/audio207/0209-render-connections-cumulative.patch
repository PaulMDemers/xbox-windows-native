+            stream->WriteReg32(0, 0);
+            return STATUS_SUCCESS;
+        }
+        KeStallExecutionProcessor(1);
+    }
+    miniport->Audio207Fault = TRUE;
+    return STATUS_IO_DEVICE_ERROR;
