+    if (!Audio207Touched || !Miniport || !Miniport->AdapterCommon)
+        return TRUE;
+    return NT_SUCCESS(Miniport->InterruptSync->CallSynchronizedRoutine(
+        CMiniportStream::Quiesce207, this));
+}
+#endif
