@@ -0,0 +1,15 @@
+/* GPL-2.0-or-later. Keep the qualified PnP forwarding path without file I/O.
+ * XBOX_NT5_VIDEO_TRACE still selects START forwarding and unload wrapping.
+ * These hooks intentionally do not require or modify any diagnostic file. */
+#include <ntddk.h>
+
+VOID NTAPI XwnVideoTraceInit(VOID) {}
+VOID NTAPI XwnVideoTrace(ULONG Event, ULONG A, ULONG B, ULONG C)
+{
+    UNREFERENCED_PARAMETER(Event);
+    UNREFERENCED_PARAMETER(A);
+    UNREFERENCED_PARAMETER(B);
+    UNREFERENCED_PARAMETER(C);
+}
+VOID NTAPI XwnVideoTraceClose(VOID) {}
+VOID NTAPI XwnVideoTracePci(VOID) {}
