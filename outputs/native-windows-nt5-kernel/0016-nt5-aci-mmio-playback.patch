@@ -169,6 +178,16 @@ STDMETHODIMP_(NTSTATUS) CAC97AdapterCommon::Init
     //
     // Get the base address for the AC97 codec and bus master.
     //
+#ifdef XBOX_NT5_AC97_MMIO
+    PCM_PARTIAL_RESOURCE_DESCRIPTOR memory = ResourceList->FindTranslatedMemory(0);
+    if (!memory || memory->u.Memory.Length < 0x180)
+        return STATUS_DEVICE_CONFIGURATION_ERROR;
+    m_pAciMapping = MmMapIoSpace(memory->u.Memory.Start, 0x180, MmNonCached);
+    if (!m_pAciMapping)
+        return STATUS_INSUFFICIENT_RESOURCES;
+    m_pCodecBase = (PUSHORT)m_pAciMapping;
+    m_pBusMasterBase = (PUCHAR)m_pAciMapping + 0x100;
+#else
     ASSERT (ResourceList->FindTranslatedPort (0));
     m_pCodecBase = (PUSHORT)ResourceList->FindTranslatedPort (0)->
                            u.Port.Start.QuadPart;
@@ -177,6 +196,8 @@ STDMETHODIMP_(NTSTATUS) CAC97AdapterCommon::Init
     m_pBusMasterBase = (PUCHAR)ResourceList->FindTranslatedPort (1)->
                               u.Port.Start.QuadPart;
 
+#endif
+
     DOUT (DBG_SYSINFO, ("Configuration:\n"
                         "   Bus Master = 0x%p\n"
                         "   Codec      = 0x%p",
@@ -237,6 +258,10 @@ CAC97AdapterCommon::~CAC97AdapterCommon ()
     PAGED_CODE ();
 
     DOUT (DBG_PRINT, ("[CAC97AdapterCommon::~CAC97AdapterCommon]"));
+#ifdef XBOX_NT5_AC97_MMIO
+    if (m_pAciMapping)
+        MmUnmapIoSpace(m_pAciMapping, 0x180);
+#endif
 }
 
 
@@ -1197,6 +1222,16 @@ STDMETHODIMP_(NTSTATUS) CAC97AdapterCommon::WriteCodecRegister
 {
     PAGED_CODE ();
 
+#ifdef XBOX_NT5_AC97_MMIO
+    /* This ACI prototype has only the stereo PCM output engine. These
+     * optional multichannel codec registers are absent from xemu's model;
+     * do not probe/write them or pretend they were programmed.
+     */
+    if (reg == AC97REG_CENTER_LFE_VOLUME || reg == AC97REG_SURROUND_VOLUME ||
+        reg == AC97REG_SURROUND_SAMPLERATE || reg == AC97REG_LFE_SAMPLERATE)
+        return STATUS_NOT_SUPPORTED;
+#endif
+
     ASSERT (reg < AC97REG_INVALID);    // audio can only be in the primary codec
 
     WORD TempData = 0;
