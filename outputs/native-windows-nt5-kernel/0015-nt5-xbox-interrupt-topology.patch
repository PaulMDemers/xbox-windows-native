@@ -266,6 +266,19 @@ DetectIsaBios(
 
     /* Detect ISA/BIOS devices */
     DetectBiosDisks(SystemKey, BusKey);
+#ifdef XBOX_NATIVE_NT5_HANDOFF
+    /* DetectBiosDisks records the boot disk geometry on SystemKey, but its
+     * shared PC implementation also invents an ISA floppy controller (IRQ 6,
+     * DMA 2, ports 3f0-3f7). Xbox has no such controller: IRQ 6 belongs to ACI.
+     * Keep the system geometry and let native PCIIDE enumerate the real disks.
+     * This ISA node is new and DetectBiosDisks is its only child producer here.
+     */
+    ASSERT(!BusKey->Child ||
+           (BusKey->Child->ComponentEntry.Type == DiskController &&
+            BusKey->Child->Sibling == NULL));
+    BusKey->Child = NULL;
+#endif
+
     DetectSerialPorts(Options, BusKey, XboxGetSerialPort, MAX_XBOX_COM_PORTS);
 
     /* FIXME: Detect more ISA devices */
