+/*227 preserving fence/download only. Must run on the actual GL worker with
+ * PGRAPH and renderer locks, stopped guest and halted producer admission.
+ * Host readback calls themselves are not cancellable; the host watchdog still
+ * bounds the wait and quarantines rather than freeing on a late result. */
+static bool preserve227_alive(NV2AState *d)
+{
+    return qatomic_read(&d->preserve227.state) == 2 &&
+           qemu_clock_get_ns(QEMU_CLOCK_REALTIME) < d->preserve227.deadline;
+}
+
+static bool preserve227_fence(NV2AState *d)
+{
+    if (!preserve227_alive(d)) { return false; }
+    GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    if (!fence) { return false; }
+    int64_t remaining = d->preserve227.deadline -
+                        qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    GLenum status = remaining > 0 ?
+        glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, remaining) :
+        GL_TIMEOUT_EXPIRED;
+    glDeleteSync(fence);
+    return (status == GL_ALREADY_SIGNALED || status == GL_CONDITION_SATISFIED) &&
+           preserve227_alive(d);
+}
