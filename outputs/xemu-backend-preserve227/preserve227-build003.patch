+        pg->inline_array_length || pg->inline_elements_length ||
+        pg->inline_buffer_length || pg->framebuffer_in_use ||
+        pg->waiting_for_nop || pg->waiting_for_flip ||
+        pg->waiting_for_context_switch || pg->flush_pending || pg->sync_pending) {
+        return 4;
+    }
+    /* Validate the complete list BEFORE any readback. Unknown/oversize ranges
+     * refuse without invalidating or clearing dirty surfaces. */
+    QTAILQ_FOREACH(s, &r->surfaces, entry) {
+        uint64_t span = (uint64_t)s->pitch * s->height;
+        if (++count > 128 || !s->width || !s->height || !s->size ||
+            s->size > 16 * MiB || span > s->size ||
+            s->vram_addr >= memory_region_size(d->vram) ||
+            s->size > memory_region_size(d->vram) - s->vram_addr) { return 4; }
+        if (s->draw_dirty || s->download_pending) { dirty++; }
