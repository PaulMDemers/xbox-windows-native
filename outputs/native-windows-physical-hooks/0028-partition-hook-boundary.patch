+           ((NtoskrnlIoSetPartitionInformation != NULL && NtoskrnlIoSetPartitionInformation != HalIoSetPartitionInformation) << 2) |
+           ((NtoskrnlIoWritePartitionTable != NULL && NtoskrnlIoWritePartitionTable != HalIoWritePartitionTable) << 3);
