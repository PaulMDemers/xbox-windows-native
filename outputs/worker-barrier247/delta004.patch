+        d->pgraph.renderer->type!=CONFIG_DISPLAY_RENDERER_OPENGL ||
+        qatomic_load_acquire(&d->worker247.state)!=0) {
+        error_setg(errp,"247 needs unused stopped CPU and acknowledged UI gate");return;
+    }
