+    trace_nv2a_lifecycle244(70,qemu_clock_get_ns(QEMU_CLOCK_REALTIME),qemu_get_thread_id(),0,1,0);
+    qemu_cond_broadcast(&d->pfifo.fifo_cond);
+    qemu_mutex_unlock(&d->pfifo.lock);
