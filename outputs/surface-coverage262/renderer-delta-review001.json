  "review_lines": [
    "--- a/hw/xbox/nv2a/pgraph/gl/surface.c",
    "+++ b/hw/xbox/nv2a/pgraph/gl/surface.c",
    "@@ -415,16 +415,31 @@",
    "",
    " /*257 Bounded scalar observation only; caller's existing PGRAPH discipline.",
    "  * No GL calls, pixel writes, resource ownership, downloads or disposal changes. */",
    "+/*262 Saturating observation ticket. One overflow marker, no ownership changes.",
    "+ * Failed strong CAS means another thread advanced the monotone counter; at",
    "+ * most limit+1 advances exist. Never wraps and never resets during a run. */",
    "+static unsigned surface262_claim(unsigned *counter, unsigned limit)",
    "+{",
    "+    unsigned seen=qatomic_read(counter);",
    "+    while (seen<=limit) {",
    "+        unsigned actual=qatomic_cmpxchg(counter,seen,seen+1);",
    "+        if (actual==seen) return seen;",
    "+        seen=actual;",
    "+    }",
    "+    return limit+1;",
    "+}",
    "+",
    " static unsigned surface257_count[13];",
    " static uint64_t surface257_sequence;",
    " static void trace_surface257(NV2AState *d, const SurfaceBinding *s, unsigned site)",
    " {",
    "     PGRAPHState *pg=&d->pgraph;",
    "     PGRAPHGLState *r=pg->gl_renderer_state;",
    "-    if (site>=13 || qatomic_read(&surface257_count[site])>=257) return;",
    "-    unsigned index=qatomic_fetch_inc(&surface257_count[site]);",
    "-    if(index>=256) {",
    "-        if(index==256) trace_nv2a_lifecycle244(99,qemu_clock_get_ns(QEMU_CLOCK_REALTIME),qemu_get_thread_id(),site,index,0);",
    "+    if (site>=13) return;",
    "+    unsigned limit=site==11 ? 4096 : 256;",
    "+    unsigned index=surface262_claim(&surface257_count[site],limit);",
    "+    if(index>=limit) {",
    "+        if(index==limit) trace_nv2a_lifecycle244(99,qemu_clock_get_ns(QEMU_CLOCK_REALTIME),qemu_get_thread_id(),site,index,0);",
    "         return;",
    "     }",
    "     uint64_t seq=qatomic_fetch_inc(&surface257_sequence)+1;"
  ],
  "only_change": "Saturating observation ticket and per-site capacity; no rendering behavior changed"
}
