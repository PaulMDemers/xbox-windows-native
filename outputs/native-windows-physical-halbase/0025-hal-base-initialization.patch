+    XwnPhaseCallback = (XWN_PHASE_CALLBACK)Callback;
+    return 0x42414854;
+#elif defined(XBOX_NT5_PHASE0_PREFLIGHT)
     if (Signature != 0x50304E54 || !Callback || XwnPhaseCallback) return 0;
