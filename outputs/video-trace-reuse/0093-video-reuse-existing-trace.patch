--- a/win32ss/drivers/miniport/xboxvmp/nt5/video_trace.c
+++ b/win32ss/drivers/miniport/xboxvmp/nt5/video_trace.c
@@ -43,8 +43,15 @@
         TraceFail(3, Status, Io.Information);
     for (I = 0; I < sizeof(Magic); ++I)
         if (((PUCHAR)TraceData)[I] != (UCHAR)Magic[I]) TraceFail(4, STATUS_DATA_ERROR, I);
+#ifdef XBOX_NT5_VIDEO_TRACE_REUSE
+    /* A previous boot's records are expected. Retain marker/length checks and
+     * all file/PCI behavior, then start this boot's in-memory trace empty. */
+    for (I = sizeof(Magic); I < sizeof(TraceData); ++I)
+        ((PUCHAR)TraceData)[I] = 0;
+#else
     for (I = sizeof(Magic); I < sizeof(TraceData); ++I)
         if (((PUCHAR)TraceData)[I]) TraceFail(4, STATUS_DATA_ERROR, I);
+#endif
 }
 
