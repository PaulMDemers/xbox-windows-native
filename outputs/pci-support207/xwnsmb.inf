; Experimental NT5 x86 package, no hardware qualification.
[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/09/2026,0.1.0.207
[Manufacturer]
%Provider%=Xbox
[Xbox]
%Device%=Telemetry,PCI\VEN_10DE&DEV_01B4&SUBSYS_00000000&REV_B1
[DestinationDirs]
DriverFiles=12
[SourceDisksNames]
1=%Media%,,,
[SourceDisksFiles]
xwnsmb.sys=1
[Telemetry]
CopyFiles=DriverFiles
[Telemetry.HW]
AddReg=Security
[Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
[Telemetry.Services]
AddService=xwnsmb,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\xwnsmb.sys
[DriverFiles]
xwnsmb.sys
[Strings]
Provider="Xbox Windows Native Project"
Device="Xbox MCPX SMBus telemetry (experimental)"
Media="Xbox NT5 SMBus telemetry package"
