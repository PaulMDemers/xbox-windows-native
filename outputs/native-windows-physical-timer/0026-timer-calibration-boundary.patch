+    State[7] = XwnRtcIdtBefore[2];
+    State[8] = Entry[0];
+    State[9] = Entry[1];
+    State[10] = Idt.Base;
+    State[11] = __inbyte(0x21) | (__inbyte(0xa1) << 8);
+    State[12] = Flags;
+    State[13] = 0;
+    XwnPhaseStep = 5;
