+#ifdef XBOX_NT5_TIMER_PREFLIGHT
+DECLSPEC_NORETURN VOID HalpXwnTimerReady(ULONG Phase, PLOADER_PARAMETER_BLOCK LoaderBlock, PVOID Caller)
+{
+    ULONG State[14], Flags = __readeflags();
+    KDESCRIPTOR Idt;
+    PULONG Entry;
+    _disable();
+    if (!XwnPhaseCallback || XwnPhaseStep != 4 || Phase != 0) for (;;) __halt();
+    __sidt(&Idt.Limit);
+    Entry = (PULONG)(Idt.Base + 0x38 * 8);
