# Track development text explicitly; keep all private media and build products local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/tools/
/tools/__pycache__/
!/outputs/
/outputs/**
!/outputs/**/
!/outputs/**/*.py
!/outputs/**/*.ps1
!/outputs/**/*.sh
!/outputs/**/*.c
!/outputs/**/*.h
!/outputs/**/*.s
!/outputs/**/*.S
!/outputs/**/*.inc
!/outputs/**/*.patch
!/outputs/**/*.md
!/outputs/**/*.txt
!/outputs/**/*.json
!/outputs/**/Makefile
!/outputs/video-nt5-display-package/xboxvnt5.inf
!/outputs/video-nt5-display-package/xwnvideo.inf
!/outputs/shutdown-null-placeholder/xwntest.inf
!/outputs/pci-support207/xwnsmb.inf
# Derived packages, extracted media, raw traces and dependency snapshots
/outputs/**/package/
/outputs/**/artifacts/
/outputs/**/artifacts-normal/
/outputs/**/installed-files/
/outputs/**/build-logs/
/outputs/**/evidence/
/outputs/**/runs/
/outputs/**/__pycache__/
/outputs/**/source-media/
# No machine-local configuration or credential files
.env
.env.*
*.key
*.pem
*.pfx
# Private artifact relocation pointers contain local paths and capture identities.
*.archive-location.json

# Private unfiltered syscall captures; versioned summaries pin their hashes.
!/docs/
!/CONTRIBUTING.md
!/LICENSE
!/LICENSES/
!/src/
!/upstream/
!/tests/
!/.github/
/tests/__pycache__/
/outputs/fatx-install-buffer/001/trace.json
/outputs/fatx-install-buffer/002/trace.json
/outputs/fatx-install-buffer/003/trace.json
# Full per-process page-entry inventory is private; a hashed summary is tracked.
/outputs/video-alias-inventory/alias-scan.json
/outputs/video-cache-contract/alias-scan.json
/outputs/video-cache-handoff/alias-scan.json

# Private full resident page-entry inventory; compact verified ranges are tracked.
/outputs/video-shared-trace2/alias-scan.json
/outputs/video-shared-trace2/scan-console.txt

# Private hives retained from direct-DDI fixture preparation failures.
/outputs/video-direct-ddi/preparation-failure*/prepared-system
# Oversized raw monitor reply journal is losslessly tracked in adjacent trace-parts.
outputs/video-mode-trace3/candidate001/trace.json

# Authored native draw regression shader sources.
!/outputs/gpu-draw-lifetime145/vs.vs.cg
!/outputs/gpu-draw-lifetime145/ps.ps.cg

# Audio207 retains full decoded event history locally; compact audit verdicts are tracked.
/outputs/audio207/*/before-*-events.json
/outputs/audio207/*/after-*-events.json
!/outputs/audio207/xwnaci207.inf

!/outputs/usb-nt5-xid/xwnxid.inf
# Authored NT5 XID restart experiment packages.
!/outputs/usb-nt5-restart/xwnxid.inf
!/outputs/usb-nt5-restart/emu001/source/xwnxid.inf
!/outputs/usb-nt5-restart/emu002/source/xwnxid.inf
