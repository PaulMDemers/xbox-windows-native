# Track development text explicitly; keep all private media and build products local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/tools/
!/outputs/
/outputs/**
!/outputs/**/
!/outputs/**/*.py
!/outputs/**/*.ps1
!/outputs/**/*.sh
!/outputs/**/*.c
!/outputs/**/*.h
!/outputs/**/*.s
!/outputs/**/*.S
!/outputs/**/*.inc
!/outputs/**/*.patch
!/outputs/**/*.md
!/outputs/**/*.txt
!/outputs/**/*.json
!/outputs/**/Makefile
# Derived packages, extracted media, raw traces and dependency snapshots
/outputs/**/package/
/outputs/**/artifacts/
/outputs/**/artifacts-normal/
/outputs/**/installed-files/
/outputs/**/build-logs/
/outputs/**/evidence/
/outputs/**/runs/
/outputs/**/__pycache__/
/outputs/**/source-media/
# No machine-local configuration or credential files
.env
.env.*
*.key
*.pem
*.pfx
