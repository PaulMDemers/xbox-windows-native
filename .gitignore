# Track development text explicitly; keep all private media and build products local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/tools/
/tools/__pycache__/
!/outputs/
/outputs/**
!/outputs/**/
!/outputs/**/*.py
!/outputs/**/*.ps1
!/outputs/**/*.sh
!/outputs/**/*.c
!/outputs/**/*.h
!/outputs/**/*.s
!/outputs/**/*.S
!/outputs/**/*.inc
!/outputs/**/*.patch
!/outputs/**/*.md
!/outputs/**/*.txt
!/outputs/**/*.json
!/outputs/**/Makefile
!/outputs/video-nt5-display-package/xboxvnt5.inf
!/outputs/video-nt5-display-package/xwnvideo.inf
!/outputs/shutdown-null-placeholder/xwntest.inf
# Derived packages, extracted media, raw traces and dependency snapshots
/outputs/**/package/
/outputs/**/artifacts/
/outputs/**/artifacts-normal/
/outputs/**/installed-files/
/outputs/**/build-logs/
/outputs/**/evidence/
/outputs/**/runs/
/outputs/**/__pycache__/
/outputs/**/source-media/
# No machine-local configuration or credential files
.env
.env.*
*.key
*.pem
*.pfx

# Private unfiltered syscall captures; versioned summaries pin their hashes.
/outputs/fatx-install-buffer/001/trace.json
/outputs/fatx-install-buffer/002/trace.json
/outputs/fatx-install-buffer/003/trace.json
# Full per-process page-entry inventory is private; a hashed summary is tracked.
/outputs/video-alias-inventory/alias-scan.json
/outputs/video-cache-contract/alias-scan.json
/outputs/video-cache-handoff/alias-scan.json

# Private full resident page-entry inventory; compact verified ranges are tracked.
/outputs/video-shared-trace2/alias-scan.json
/outputs/video-shared-trace2/scan-console.txt

# Private hives retained from direct-DDI fixture preparation failures.
/outputs/video-direct-ddi/preparation-failure*/prepared-system
